// The filmstrip along the foot of the window: the folder's frames in a
// row, scrolled sideways by the wheel, the keys and a bar along its
// foot.

import { Theme } from "../theme.slint";
import { StripPlace, Thumb, ThumbCell } from "../structs.slint";
import { NameTip, ScrollBand, ThumbBadges, ThumbMarks, ThumbStack, ThumbTag } from "../controls.slint";

export component Filmstrip inherits Rectangle {
    /// Every row; the cells are drawn from `cells`, the rows on screen
    /// and a margin, each placed by its row.
    in property <[Thumb]> thumbs;
    in property <[ThumbCell]> cells;
    in-out property <int> selected;
    /// A click on a frame, with Ctrl and Shift as they were held
    /// when it was pressed.
    callback frame-clicked(int, bool, bool);
    /// A right-click on a frame (or, on a Mac, a Control+click): the
    /// row and where, in the window's logical pixels.
    callback frame-menu(int, length, length);
    /// A click on a stack's badge: the stack of that row opened or
    /// closed.
    callback stack-clicked(int);
    /// Whether the frame menu is up: a press that closes it reaches
    /// the cell under it too, and is not a click there.
    pure callback menu-shown() -> bool;
    /// Whether Control+click is a right-click, as on a Mac. Slint
    /// calls the Mac's Command key `control` and its Control key
    /// `meta`, so it is `meta` held that is asked for.
    in property <bool> ctrl-click-menu;
    /// For a snapshot (`--menu`): the row to open the menu over, as
    /// if right-clicked in its middle; -1 for none.
    in property <int> menu-at: -1;
    changed menu-at => {
        if (self.menu-at >= 0 && self.menu-at < self.thumbs.length) {
            let p = self.strip-place(self.menu-at, self.shape);
            self.frame-menu(self.menu-at,
                strip.absolute-position.x + strip.content-x + p.x + p.width / 2,
                strip.absolute-position.y + strip.height / 2);
        }
    }
    in property <int> meta-stars;
    /// The layout's number, which changes as the rows' shapes come in:
    /// passed with each question so a binding asks again.
    in property <int> shape;
    /// Where row `row`'s cell is along the row, its width, and its
    /// picture in it (the ring's inset from the cell's left and the
    /// picture's width), at layout `shape`; and the row's whole length,
    /// both pads included.
    pure callback strip-place(int, int) -> StripPlace;
    pure callback strip-length(int) -> length;
    /// The pictures' height, and the ring each is inset by inside its
    /// frame; a frame narrower than its cell sits at the place's inset.
    in property <length> strip-photo;
    in property <length> strip-ring;
    in property <length> strip-pad;
    /// A cell's height: the picture in its ring and the name's line.
    in property <length> cell-h;
    /// The padding under the cells, where the scroll bar runs: the
    /// pad, or more for a thumb too wide for it.
    in property <length> strip-foot;
    /// Scroll the strip by a wheel's delta, kept within its ends.
    function strip-scroll(by: length) {
        strip.content-x = min(0px, max(strip.width - strip.content-width, strip.content-x + by));
    }
    /// How far the strip can be scrolled: the row less what is on
    /// screen, the bar's range.
    property <length> strip-max: max(0px, strip.content-width - strip.width);
    /// Scroll the strip to `to` along the row, held to its range: the
    /// bar's drag and its track.
    function strip-scroll-to(to: length) {
        strip.content-x = -clamp(to, 0px, root.strip-max);
    }
    callback strip-relay();
    callback strip-renew();
    callback strip-report();
    callback focus-keys();
    /// The scroll bar's thumb, asked of the grid's arithmetic along
    /// the strip's width, and whether it is awake after a scroll.
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    in-out property <bool> bar-awake;
    // The Flickable's scroll and extent, for App's reveal and report,
    // which read and set them through this component's id.
    in-out property <length> content-x <=> strip.content-x;
    out property <length> content-width: strip.content-width;

    height: root.strip-pad + root.cell-h + root.strip-foot;
    // A list of another length: the window lays the strip out afresh
    // from its start, or holds it still when frames were only taken
    // out. Its length changing as shapes come in is neither, and the
    // window holds the scroll still under those.
    property <int> count: root.thumbs.length;
    changed count => { root.strip-renew(); }
    background: Theme.surface;
    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
    // A wheel over the strip scrolls it sideways. Slint's
    // Flickable only takes a wheel along an axis it can
    // move, and this one moves in x alone, so the vertical
    // wheel is turned here: this TouchArea encloses the
    // strip and sees what the thumbnails and the Flickable
    // reject. Dragging is the Flickable's own, and it
    // cancels the thumbnail's click once it takes over.
    TouchArea {
        scroll-event(e) => {
            // Only the vertical wheel: one with a sideways
            // component is the Flickable's, which has the
            // room for it and takes it before this is asked.
            if (e.delta-y == 0px) { return reject; }
            root.strip-scroll(e.delta-y);
            return accept;
        }
        strip := Flickable {
            content-width: max(self.width, root.strip-length(root.shape));
            // No room to move in y, or the Flickable takes the
            // vertical wheel for itself: its content would
            // otherwise be the row's preferred height, a few
            // pixels taller than the strip, and a wheel would
            // nudge the thumbnails up instead of along.
            content-height: self.height;
            changed content-x => { root.strip-report(); }
            // The first layout, and a new width.
            changed width => { root.strip-relay(); }
            // Each cell where its row puts it, its picture's shape at
            // the row's height or the floor its name needs: the picture
            // in the ring, centered when the cell is wider, the name
            // under the ring across the cell, a gap between cells.
            for c in root.cells: cell := Rectangle {
                property <int> i: c.row;
                property <Thumb> t: c.thumb;
                property <StripPlace> p: root.strip-place(self.i, root.shape);
                x: self.p.x;
                y: root.strip-pad;
                width: self.p.width;
                height: root.cell-h;
                // The current frame, and the set it is one of:
                // every frame in the set wears the selection's
                // ground, the current one its ring as well.
                property <bool> on: i == root.selected;
                property <bool> in-set: on || t.chosen;
                property <length> ring: root.strip-ring;
                property <length> photo-h: root.strip-photo;
                property <length> photo-w: self.p.photo;
                // The ring and the hover's ground hug the picture and
                // the color band under it, not the cell, and end above
                // the name, which is never inside the ring.
                frame := Rectangle {
                    x: cell.p.inset;
                    y: 0;
                    width: photo-w + 2 * ring;
                    height: ring + photo-h + Theme.space-1 + ring;
                    border-radius: Theme.radius-sm;
                    background: in-set ? Theme.selection : (tt.has-hover ? Theme.hover : transparent);
                    border-width: on ? 2px : (in-set ? 1px : 0);
                    border-color: on ? Theme.accent : Theme.accent-muted;
                    animate background { duration: Theme.quick; }
                    // The picture, inset by the ring alone; below it
                    // the gap where a color label's band goes, whether
                    // or not this frame carries one, so a label never
                    // moves the name.
                    Image {
                        x: ring;
                        y: ring;
                        width: photo-w;
                        height: photo-h;
                        source: t.image;
                        // A frame whose root is offline: there, but not
                        // to be had until the drive is back.
                        opacity: t.offline ? 0.4 : 1;
                        image-fit: contain;
                    }
                    // Where the picture would be, as the grid marks it.
                    if t.failed: Rectangle {
                        x: ring;
                        y: ring;
                        width: photo-w;
                        height: photo-h;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        Text {
                            text: "Unreadable";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // Over the picture's bottom corner, not in
                    // the row with the name: the badges must
                    // not push the name out of the middle, and
                    // the cell's height is the strip's.
                    ThumbBadges {
                        x: ring + Theme.space-1;
                        y: ring + photo-h - self.height - Theme.space-1;
                        rating: t.rating;
                        flag: t.flag;
                        label: t.label;
                        stars: root.meta-stars;
                    }
                    // The picture's top right corner: the badges are
                    // at the bottom left, so the two never meet.
                    marks := ThumbMarks {
                        x: parent.width - ring - Theme.space-1 - self.width;
                        y: ring + Theme.space-1;
                        edited: t.edited;
                        exported: t.exported;
                        collected: t.collected;
                        paired: t.paired;
                    }
                    // A version's name on the top left, short of the
                    // marks.
                    ThumbTag {
                        x: ring + Theme.space-1;
                        y: ring + Theme.space-1;
                        name: t.version;
                        most: parent.width - 2 * (ring + Theme.space-1)
                            - (marks.visible ? marks.width + Theme.space-1 : 0);
                    }
                    // The strip sits beside the developed picture,
                    // where a tinted plate would pull the eye's color
                    // judgment, so a color label shows as a band
                    // instead: below the picture and inside the
                    // border, clear of both it and the name below,
                    // and clear of the badges over the picture above.
                    if t.label > 0: Rectangle {
                        x: ring;
                        y: ring + photo-h + 1px;
                        width: photo-w;
                        height: 3px;
                        background: Theme.label-color(t.label);
                    }
                }
                name-text := Text {
                    x: 0;
                    y: frame.height + 2px;
                    width: parent.width;
                    // To the cell's foot, the descenders' room.
                    height: parent.height - self.y;
                    text: t.name;
                    color: in-set ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    overflow: elide;
                    // Cut short, the whole name at the pointer.
                    NameTip {
                        width: 100%;
                        height: 100%;
                        name: t.name;
                        cut: name-text.preferred-width > name-text.width;
                        row-hover: tt.has-hover;
                        shape: root.shape;
                        // Over the name, not the picture.
                        hover: tt.has-hover && tt.mouse-y >= name-text.y;
                        pointer-x: tt.mouse-x;
                        pointer-y: tt.mouse-y;
                        downs: tt.downs;
                        scroll: strip.content-x;
                        quiet: root.menu-shown();
                    }
                }
                // `clicked` carries no modifiers, so the press
                // says which were held and the click reads them.
                // A right-click asks for the menu on the press,
                // as a desktop's menus open; a Mac's
                // Control+click is one, and its click is then
                // not also a click.
                tt := TouchArea {
                    property <bool> ctrl;
                    property <bool> shift;
                    property <bool> menu;
                    /// Presses of any button, for the name's tip.
                    property <int> downs;
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.downs += 1;
                            let closing = root.menu-shown();
                            self.menu = closing || e.button == PointerEventButton.right
                                || (root.ctrl-click-menu && e.button == PointerEventButton.left
                                    && e.modifiers.meta);
                            if (closing && e.button == PointerEventButton.left
                                && !(root.ctrl-click-menu && e.modifiers.meta)) {
                                // The press closed the menu: nothing more.
                                return;
                            }
                            if (self.menu) {
                                root.focus-keys();
                                root.frame-menu(i, self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                                return;
                            }
                            self.ctrl = e.modifiers.control;
                            self.shift = e.modifiers.shift;
                        }
                    }
                    clicked => {
                        if (self.menu) { return; }
                        root.focus-keys();
                        root.frame-clicked(i, self.ctrl, self.shift);
                    }
                }
                // The stack's badge on the picture's bottom right, over
                // the cell's press so a click on it is the badge's.
                ThumbStack {
                    x: frame.x + frame.width - ring - Theme.space-1 - self.width;
                    y: ring + photo-h - self.height - Theme.space-1;
                    count: t.stack;
                    place: t.stack-place;
                    open: t.stack-open;
                    clicked => {
                        root.focus-keys();
                        root.stack-clicked(i);
                    }
                }
            }
        }
    }
    // The scroll bar, the grid's along the strip's foot: in the
    // strip's padding below the cells rather than the grid's wider
    // band, so its track never covers a frame's ring and a frame keeps
    // every pixel of its click. The thumb keeps its 4 px from the foot.
    ScrollBand {
        horizontal: true;
        y: parent.height - root.strip-foot;
        width: parent.width;
        height: root.strip-foot;
        label: "Strip scroll";
        scroll: -strip.content-x;
        max: root.strip-max;
        awake <=> root.bar-awake;
        scroll-to(to) => { root.strip-scroll-to(to); }
        // Either wheel moves the strip along, as over the frames.
        wheel(dx, dy, ctrl) => { root.strip-scroll(dy != 0px ? dy : dx); }
        bar-length(a, b) => { return root.bar-length(a, b); }
        bar-offset(a, b, c) => { return root.bar-offset(a, b, c); }
        bar-drag(a, b, c, d) => { return root.bar-drag(a, b, c, d); }
        menu-shown => { return root.menu-shown(); }
        focus-keys => { root.focus-keys(); }
    }
}
