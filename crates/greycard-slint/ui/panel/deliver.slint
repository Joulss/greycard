// The export sheet: the format, the size, the sharpening and the color
// space an export is written in, what it says of where it came from,
// and the watermark laid over it, kept by name as presets; over
// everything until a choice is made.

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { EditSlider, Steps, Toggle, PanelButton, Segmented, ScrollPane, SliderKeys } from "../controls.slint";
import { QueueRow } from "../structs.slint";

// Nine places for a watermark, three by three, one chosen.
component PositionGrid inherits Rectangle {
    in-out property <string> current;
    property <[[string]]> rows: [
        ["Top left", "Top", "Top right"],
        ["Left", "Center", "Right"],
        ["Bottom left", "Bottom", "Bottom right"],
    ];
    width: 3 * 22px + 2 * 3px;
    height: 3 * 16px + 2 * 3px;
    VerticalLayout {
        spacing: 3px;
        for row in root.rows: HorizontalLayout {
            spacing: 3px;
            for name in row: Rectangle {
                property <bool> on: name == root.current;
                width: 22px;
                height: 16px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: on ? Theme.accent : Theme.border-strong;
                background: on ? Theme.accent : (t.has-hover ? Theme.hover : Theme.base);
                t := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.current = name; }
                }
            }
        }
    }
}

export component ExportSheet inherits Rectangle {
    in property <string> file-name;
    /// The frames selected: two or more are exported as a set, into a
    /// folder, each under its own edit.
    in property <int> set-count: 1;
    callback export();
    /// A set is being exported: the queue waits for it.
    in property <bool> exporting;
    /// The export queue: how many sets wait, the line that counts them,
    /// and whether it is being run.
    in property <int> queue-sets;
    in property <string> queue-line;
    in property <bool> queue-running;
    /// Add to queue: what Export would send, kept for later.
    callback queue-add();
    callback queue-run();
    callback queue-clear();
    /// The sets queued, one row each, and the bin that takes one out.
    in property <[QueueRow]> queue-rows;
    callback queue-remove(int);
    /// A row's height, and how many show before the list scrolls.
    property <length> queue-row-height: Theme.control-height - 6px;
    property <int> queue-rows-shown: 5;
    /// Clear was pressed and not yet confirmed.
    property <bool> confirm-clear: false;
    in-out property <bool> export-open;
    in-out property <string> export-format;
    in-out property <float> export-quality;
    in-out property <string> export-size;
    in-out property <string> export-custom;
    in-out property <int> frame-width;
    in-out property <int> frame-height;
    pure callback custom-edge(string) -> int;
    pure callback export-subfolder-name(string) -> string;
    pure callback export-subfolder-problem(string) -> string;
    /// The folder an export goes into beside each frame, as the export
    /// reads the Subfolder field; empty when there is none.
    property <string> sub-name: root.export-subfolder-name(root.export-subfolder);
    property <string> sub-problem: root.export-subfolder-problem(root.export-subfolder);
    /// The Folder row: where Export writes, as the export itself will
    /// decide it (the typed subfolder, the frame by its name and its
    /// row, since two frames of one name in two folders are two places,
    /// and the last folder chosen, which `export-folder-turn` counts),
    /// cut at the front to `folder-room` characters so the leaf shows.
    pure callback export-folder-line(string, string, int, int, int) -> string;
    in property <int> frame-index;
    in property <int> export-folder-turn;
    /// The row's Choose button: the folder chooser.
    callback export-folder-choose();
    property <string> folder-line: root.export-folder-line(root.export-subfolder, root.file-name, root.frame-index, root.export-folder-turn, root.folder-room);
    /// How many characters the row's folder holds: the sheet's row
    /// less its label, the button and the gaps, at a conservative 7px
    /// a character; the text also elides whatever still overflows.
    property <int> folder-room: max(8, floor((root.sheet-width - 2 * Theme.space-5 - 68px - 88px - 2 * Theme.space-2) / 7px));
    /// A watermark place's words: the setting keeps the English name.
    pure function position-words(place: string) -> string {
        return place == "Top left" ? @tr("Top left")
            : place == "Top" ? @tr("Top")
            : place == "Top right" ? @tr("Top right")
            : place == "Left" ? @tr("Left")
            : place == "Center" ? @tr("Center")
            : place == "Right" ? @tr("Right")
            : place == "Bottom left" ? @tr("Bottom left")
            : place == "Bottom" ? @tr("Bottom")
            : place == "Bottom right" ? @tr("Bottom right")
            : place;
    }
    /// A border color's words: the setting keeps the English name.
    pure function border-words(color: string) -> string {
        return color == "White" ? @tr("White")
            : color == "Light grey" ? @tr("Light grey")
            : color == "Dark grey" ? @tr("Dark grey")
            : color == "Black" ? @tr("Black")
            : color;
    }
    /// The long edge the sheet asks for; 0 is the picture's own.
    pure function export-edge() -> int {
        if (root.export-size == "Full") { return 0; }
        if (root.export-size == "Custom") { return root.custom-edge(root.export-custom); }
        return root.export-size.to-float();
    }
    /// Whether the export comes out smaller than the picture.
    pure function export-resizes() -> bool {
        return root.export-edge() > 0 && root.export-edge() < max(root.frame-width, root.frame-height);
    }
    pure function export-width() -> int {
        return root.export-resizes() ? round(root.frame-width * root.export-edge() / max(root.frame-width, root.frame-height)) : root.frame-width;
    }
    pure function export-height() -> int {
        return root.export-resizes() ? round(root.frame-height * root.export-edge() / max(root.frame-width, root.frame-height)) : root.frame-height;
    }
    in-out property <string> export-space;
    in-out property <bool> export-embed;
    in-out property <string> export-sharpen;
    in-out property <string> export-on-exists;
    in-out property <string> export-subfolder;
    /// The pattern each file is named by.
    in-out property <string> export-name;
    /// The first frame's file under a pattern, for a subfolder, a
    /// format, the frame (its name and its row), the set's size, and the
    /// folder's turn; and whether the pattern names no file, so the
    /// frame's own name stands in.
    pure callback export-name-example(string, string, string, string, int, int, int) -> string;
    pure callback export-name-refused(string) -> bool;
    /// The sheet is up: what the line under Name read of the files
    /// before is read again.
    callback sheet-opened();
    init => { root.sheet-opened(); }
    property <string> name-example: root.export-name-example(root.export-name, root.export-subfolder, root.export-format, root.file-name, root.frame-index, root.set-count, root.export-folder-turn);
    in-out property <string> export-metadata;
    in-out property <string> export-mark;
    in-out property <string> export-mark-text;
    in-out property <string> export-mark-image-name;
    in-out property <string> export-mark-color;
    in-out property <string> export-mark-position;
    in-out property <float> export-mark-size;
    in-out property <float> export-mark-margin;
    in-out property <float> export-mark-opacity;
    in-out property <bool> export-border;
    in-out property <float> export-border-width;
    in-out property <string> export-border-color;
    /// The border's band in pixels on the export, as the export works
    /// it out: a share of the long edge, at least one.
    pure function border-band() -> int {
        return max(1, round(max(root.export-width(), root.export-height()) * clamp(root.export-border-width, 0.5, 25) / 100));
    }
    callback export-mark-choose();
    /// The picker's entries, "None" first, and the one on show.
    in-out property <[string]> export-presets;
    in-out property <string> export-preset;
    in-out property <bool> export-preset-edited;
    callback export-preset-chosen(string);
    callback export-preset-saved(string);
    callback export-preset-deleted();
    /// Whether a preset of that name, in any case, is there already:
    /// Save then says Replace.
    pure callback export-preset-exists(string) -> bool;
    property <bool> naming: false;
    // The name row gone, or the queue's question answered, takes the
    // focused field or button with it: the keys are the sheet's again.
    changed naming => { if (!root.naming) { keys.focus(); } }
    changed confirm-clear => { keys.focus(); }
    /// Counted up by the window for a field or slider here letting go
    /// of the keys: the sheet's again, not the window's.
    in property <int> keys-back;
    changed keys-back => { keys.focus(); }
    /// Counted up by the window for a key a focused slider here did
    /// not take (`SliderKeys.passed-key`): the sheet's, Enter included.
    in property <int> key-passed;
    changed key-passed => { keys.key-pressed(SliderKeys.passed-key); }
    property <string> new-name;
    property <length> sheet-width: 420px;

    background: #000000a0;
    TouchArea { clicked => { root.export-open = false; } }
    card := Rectangle {
        width: root.sheet-width;
        // The header and the buttons always show; the choices between
        // them scroll when the window is too short for all of them.
        height: min(header.preferred-height + body.preferred-height + footer.preferred-height + 2px,
                    root.height - 2 * Theme.space-5);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        clip: true;
        TouchArea { }
        // The sheet takes the keys while it is up: Enter is Export's,
        // Escape Cancel's. A field or a control with the focus keeps
        // its own Enter; only a dialog, which took the focus anyway,
        // hands it back here.
        keys := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                // The open question first: the name row's Cancel, the
                // queue's no; else the sheet's.
                if (e.text == Key.Escape) {
                    if (root.naming) {
                        root.naming = false;
                    } else if (root.confirm-clear) {
                        root.confirm-clear = false;
                    } else {
                        root.export-open = false;
                    }
                    return accept;
                }
                // The preset list opens on Enter and still lets the
                // press come up: the list's, not Export's.
                if (e.text == Key.Return && presets.has-focus) { return accept; }
                if (e.text == Key.Return) {
                    // Not while the queue's Clear is asked, nor while
                    // Export is off.
                    if (!e.repeat && !root.confirm-clear && root.sub-problem == "") {
                        root.export-open = false;
                        root.export();
                    }
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                header := VerticalLayout {
                    padding: Theme.space-5;
                    padding-bottom: Theme.space-3;
                    spacing: Theme.space-2;
                    Text {
                        text: root.set-count > 1 ? @tr("Export {n} frame" | "Export {n} frames" % root.set-count) : @tr("Export");
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-medium;
                        color: Theme.text;
                    }
                    Text {
                        text: root.set-count > 1
                            ? @tr("{} and {n} other, each under its own edit" | "{} and {n} others, each under its own edit" % (root.set-count - 1), root.file-name)
                            : root.file-name;
                        wrap: word-wrap;
                        font-size: Theme.font-sm;
                        color: Theme.text-secondary;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Text { text: @tr("Preset"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                        presets := ComboBox {
                            horizontal-stretch: 1;
                            model: root.export-presets;
                            current-value <=> root.export-preset;
                            selected(v) => { root.naming = false; root.export-preset-chosen(v); }
                        }
                        Text {
                            text: root.export-preset-edited ? @tr("(edited)") : "";
                            width: 52px;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                        }
                    }
                    if !root.naming: HorizontalLayout {
                        spacing: Theme.space-2;
                        padding-left: 68px + Theme.space-2;
                        PanelButton {
                            text: @tr("Save as...");
                            clicked => {
                                root.new-name = root.export-preset == "None" ? "" : root.export-preset;
                                root.naming = true;
                            }
                        }
                        PanelButton {
                            text: @tr("Delete");
                            enabled: root.export-preset != "None" && root.export-preset != "";
                            clicked => { root.export-preset-deleted(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.naming: HorizontalLayout {
                        spacing: Theme.space-2;
                        Text { text: @tr("Name"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.new-name;
                            placeholder-text: @tr("Web 2048");
                            accepted(t) => {
                                if (t.to-lowercase() != "none" && t != "") { root.naming = false; root.export-preset-saved(t); }
                            }
                            init => { self.focus(); }
                        }
                        PanelButton {
                            // Over a preset of that name, in any case.
                            text: root.export-preset-exists(root.new-name) ? @tr("Replace") : @tr("Save");
                            primary: true;
                            enabled: root.new-name != "" && root.new-name.to-lowercase() != "none";
                            clicked => { root.naming = false; root.export-preset-saved(root.new-name); }
                        }
                        PanelButton {
                            text: @tr("Cancel");
                            clicked => { root.naming = false; }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                ScrollPane {
                    vertical-stretch: 1;
                    body := VerticalLayout {
                        alignment: start;
                        padding-left: Theme.space-5;
                        padding-right: Theme.space-5;
                        padding-top: Theme.space-3;
                        padding-bottom: Theme.space-3;
                        spacing: Theme.space-2;
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Format"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["JPEG", "PNG", "TIFF 16-bit"]; labels: ["JPEG", "PNG", @tr("TIFF 16-bit")]; current <=> root.export-format; }
                        }
                        EditSlider {
                            label: @tr("Quality");
                            enabled: root.export-format == "JPEG";
                            minimum: 50;
                            maximum: 100;
                            default: 92;
                            step: 1;
                            steps: Steps.whole;
                            value <=> root.export-quality;
                            text: round(root.export-quality);
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Long edge"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["Full", "4096", "2048", "1024", "Custom"]; labels: [@tr("Full"), "4096", "2048", "1024", @tr("Custom")]; current <=> root.export-size; }
                        }
                        if root.export-size == "Custom": HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Pixels"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                width: 96px;
                                text <=> root.export-custom;
                                placeholder-text: "1600";
                                input-type: number;
                            }
                            // What comes out at that edge, or the picture's
                            // own when the number is no smaller, or no size.
                            Text {
                                text: root.frame-width > 0
                                    ? (root.export-resizes()
                                        ? root.export-width() + " × " + root.export-height()
                                        : @tr("{} × {}, as it is", root.frame-width, root.frame-height))
                                    : "";
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Sharpen"); width: 68px; color: root.export-resizes() ? Theme.text : Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["Off", "Low", "Standard", "High"]; labels: [@tr("Off"), @tr("Low"), @tr("Standard"), @tr("High")]; current <=> root.export-sharpen; }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Color"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["sRGB", "Display P3", "Rec.2020", "Adobe RGB"]; current <=> root.export-space; }
                        }
                        Toggle {
                            label: @tr("Embed profile");
                            checked <=> root.export-embed;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Metadata"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["All", "No edit", "None"]; labels: [@tr("All"), @tr("No edit"), @tr("None")]; current <=> root.export-metadata; }
                        }
                        // Typed, every export goes into it beside each frame
                        // with no chooser; left empty, the chooser asks.
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Subfolder"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.export-subfolder;
                                placeholder-text: @tr("None: the folder below");
                            }
                        }
                        // Always there, so the sheet does not move as the
                        // field is typed in: blank when there is nothing to say.
                        Text {
                            text: root.sub-name != "" ? @tr("Saved in {} beside each original.", root.sub-name)
                                : root.sub-problem != "" ? root.sub-problem : " ";
                            color: root.sub-problem != "" ? Theme.warn-yellow : Theme.text-secondary;
                            font-size: Theme.font-sm;
                            // Any character may break, so a long run
                            // without a space never widens the sheet.
                            wrap: char-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Name"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.export-name;
                                placeholder-text: "{name}";
                            }
                        }
                        // The first frame's file as the pattern names it,
                        // in the warning's color when the pattern names
                        // none and the frame's own name stands in.
                        Text {
                            text: root.name-example != "" ? root.name-example : " ";
                            color: root.export-name-refused(root.export-name) ? Theme.warn-yellow : Theme.text-secondary;
                            font-size: Theme.font-sm;
                            wrap: char-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("If it exists"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["Increment", "Overwrite", "Skip"]; labels: [@tr("Increment"), @tr("Overwrite"), @tr("Skip")]; current <=> root.export-on-exists; }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Watermark"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Segmented { options: ["Off", "Text", "Image"]; labels: [@tr("Off"), @tr("Text"), @tr("Image")]; current <=> root.export-mark; }
                        }
                        if root.export-mark == "Text": HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Text"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.export-mark-text;
                                placeholder-text: @tr("© Your Name");
                            }
                            Segmented { width: 110px; options: ["White", "Black"]; labels: [@tr("White"), @tr("Black")]; current <=> root.export-mark-color; }
                        }
                        if root.export-mark == "Image": HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: @tr("Image"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            Text {
                                text: root.export-mark-image-name == "" ? @tr("No PNG chosen") : root.export-mark-image-name;
                                color: root.export-mark-image-name == "" ? Theme.text-muted : Theme.text-secondary;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            PanelButton {
                                text: @tr("Choose...");
                                clicked => { root.export-mark-choose(); keys.focus(); }
                            }
                        }
                        // Where it goes beside how big, how far in and how
                        // strong: one block rather than four rows.
                        if root.export-mark != "Off": HorizontalLayout {
                            spacing: Theme.space-3;
                            VerticalLayout {
                                width: 68px;
                                alignment: center;
                                spacing: Theme.space-1;
                                PositionGrid { current <=> root.export-mark-position; }
                                Text {
                                    text: root.position-words(root.export-mark-position);
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-xs;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 0;
                                EditSlider {
                                    label: @tr("Size");
                                    minimum: 1;
                                    maximum: 50;
                                    default: 15;
                                    step: 0.5;
                                    steps: Steps.halves;
                                    value <=> root.export-mark-size;
                                    text: round(root.export-mark-size * 10) / 10 + " %";
                                }
                                EditSlider {
                                    label: @tr("Margin");
                                    minimum: 0;
                                    maximum: 10;
                                    default: 2;
                                    step: 0.1;
                                    steps: Steps.tenths;
                                    value <=> root.export-mark-margin;
                                    text: round(root.export-mark-margin * 10) / 10 + " %";
                                }
                                EditSlider {
                                    label: @tr("Opacity");
                                    minimum: 5;
                                    maximum: 100;
                                    default: 60;
                                    step: 1;
                                    steps: Steps.whole;
                                    value <=> root.export-mark-opacity;
                                    text: round(root.export-mark-opacity) + " %";
                                }
                            }
                        }
                        // A band round the picture: off, or one of five
                        // colors, Match being the picture's own mean. A
                        // color both picks it and turns the border on.
                        HorizontalLayout {
                            spacing: 4px;
                            Text { text: @tr("Border"); width: 68px + Theme.space-2 - 4px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            for choice in [
                                { name: "Off", fill: Theme.base, word: @tr("Off"), wide: true },
                                { name: "White", fill: #ffffff, word: "", wide: false },
                                { name: "Light grey", fill: #cccccc, word: "", wide: false },
                                { name: "Dark grey", fill: #333333, word: "", wide: false },
                                { name: "Black", fill: #000000, word: "", wide: false },
                                { name: "Match", fill: Theme.base, word: @tr("Match"), wide: true },
                            ]: Rectangle {
                                property <bool> on: choice.name == "Off" ? !root.export-border
                                    : root.export-border && choice.name == root.export-border-color;
                                width: choice.wide ? 48px : 24px;
                                height: 24px;
                                border-radius: Theme.radius-sm;
                                border-width: on ? 2px : 1px;
                                border-color: on ? Theme.accent : Theme.border-strong;
                                background: choice.wide && t.has-hover ? Theme.hover : choice.fill;
                                Text {
                                    text: choice.word;
                                    color: on ? Theme.text : Theme.text-secondary;
                                    font-size: Theme.font-xs;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                t := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        if (choice.name == "Off") {
                                            root.export-border = false;
                                        } else {
                                            root.export-border = true;
                                            root.export-border-color = choice.name;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.export-border && root.export-border-color != "Match" ? root.border-words(root.export-border-color) : "";
                                color: Theme.text-secondary;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        if root.export-border: EditSlider {
                            label: @tr("Width");
                            minimum: 0.5;
                            maximum: 25;
                            default: 5;
                            step: 0.5;
                            steps: Steps.halves;
                            value <=> root.export-border-width;
                            text: round(root.export-border-width * 10) / 10 + " %";
                        }
                        if root.export-border: Text {
                            text: root.frame-width > 0
                                ? @tr("Added outside the picture; the file is {} × {}.", root.export-width() + 2 * root.border-band(), root.export-height() + 2 * root.border-band())
                                : @tr("Added outside the picture.");
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                footer := VerticalLayout {
                    padding: Theme.space-5;
                    padding-top: Theme.space-3;
                    spacing: Theme.space-3;
                    // Where Export writes, in the footer rather than among
                    // the choices: it is what the button below acts on, so
                    // it stays in view with it however short the window.
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Text { text: @tr("Folder"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                        Text {
                            text: root.folder-line;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        PanelButton {
                            text: @tr("Choose...");
                            clicked => { root.export-folder-choose(); keys.focus(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: @tr("Cancel");
                            clicked => { root.export-open = false; }
                        }
                        // What Export would send, kept to be sent later.
                        PanelButton {
                            text: @tr("Add to queue");
                            clicked => { root.export-open = false; root.queue-add(); }
                        }
                    }
                    // Into the folder the row shows, with no dialog.
                    PanelButton {
                        text: @tr("Export");
                        icon: @image-url("../icons/image-down.svg");
                        primary: true;
                        enabled: root.sub-problem == "";
                        clicked => { root.export-open = false; root.export(); }
                    }
                    // The queue's sets, one row each, the bin at its end
                    // taking that set out at once; past five rows the list
                    // scrolls in its own box, so the sheet does not grow.
                    if root.queue-rows.length > 0: Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.base;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: min(queue-list.preferred-height,
                                    root.queue-rows-shown * root.queue-row-height + (root.queue-rows-shown - 1) * 2px + 4px);
                        ScrollPane {
                            queue-list := VerticalLayout {
                                padding: 2px;
                                spacing: 2px;
                                for row[i] in root.queue-rows: Rectangle {
                                    height: root.queue-row-height;
                                    border-radius: Theme.radius-sm;
                                    background: row.running ? Theme.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: Theme.space-2;
                                        // Clears the scroll bar, as the
                                        // presets list does.
                                        padding-right: Theme.space-1 + Theme.scrollbar-band;
                                        spacing: Theme.space-2;
                                        Text {
                                            text: row.name;
                                            width: 96px;
                                            color: row.running ? Theme.text : Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.running ? @tr("{}, running", row.frames) : row.frames;
                                            color: row.running ? Theme.text : Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.folder;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            width: root.queue-row-height;
                                            accessible-role: button;
                                            accessible-label: @tr("Remove {}", row.name);
                                            accessible-enabled: !row.running;
                                            accessible-action-default => { if (!row.running) { root.queue-remove(i); } }
                                            Image {
                                                source: @image-url("../icons/trash-2.svg");
                                                colorize: row.running ? Theme.text-muted
                                                    : bin.has-hover ? Theme.text : Theme.text-muted;
                                                opacity: row.running ? 0.4 : 1;
                                                width: Theme.icon;
                                                height: Theme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            bin := TouchArea {
                                                enabled: !row.running;
                                                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => { root.queue-remove(i); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The queue: its count, run it, or clear it after asking.
                    if root.queue-sets > 0 && !root.confirm-clear: HorizontalLayout {
                        spacing: Theme.space-2;
                        Text {
                            text: root.queue-running ? @tr("{}, running", root.queue-line) : root.queue-line;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        PanelButton {
                            text: @tr("Export the queue");
                            enabled: !root.exporting;
                            clicked => { root.export-open = false; root.queue-run(); }
                        }
                        PanelButton {
                            text: @tr("Clear");
                            enabled: !root.queue-running;
                            clicked => { root.confirm-clear = true; }
                        }
                    }
                    if root.queue-sets > 0 && root.confirm-clear: HorizontalLayout {
                        spacing: Theme.space-2;
                        Text {
                            text: @tr("Clear the queue of {n} set?" | "Clear the queue of {n} sets?" % root.queue-sets);
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        PanelButton {
                            text: @tr("Cancel");
                            clicked => { root.confirm-clear = false; }
                        }
                        PanelButton {
                            text: @tr("Clear");
                            primary: true;
                            clicked => { root.confirm-clear = false; root.queue-clear(); }
                        }
                    }
                }
            }
        }
    }
}
