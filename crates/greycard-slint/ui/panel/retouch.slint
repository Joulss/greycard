// The RETOUCH section: the tools, the next or chosen repair's size,
// feather and opacity, and the repairs by name; a Fill the generative
// remove made has Another on its row, its next variation.

import { Theme } from "../theme.slint";
import { TipArea, Section, EditSlider, Steps, PanelButton, Segmented } from "../controls.slint";

export component RetouchSection inherits Section {
    in-out property <bool> retouch-enabled;
    in-out property <bool> collapsed-retouch;
    callback develop-changed();
    in-out property <string> retouch-mode;
    in-out property <float> patch-size;
    in-out property <float> patch-feather;
    in-out property <float> patch-opacity;
    in-out property <[string]> patch-names;
    in-out property <int> patch;
    in-out property <bool> patch-varies;
    // What makes a Fill: shown with the Fill in hand or a Fill chosen,
    // the chosen one's or the next one's, and why each of Patch, Fast
    // and Best cannot run here ("" when it can).
    in property <bool> fill-shown;
    in-out property <string> fill-choice;
    in property <[string]> fill-why-not;
    callback fill-chosen(string);
    callback retouch-toggled(string);
    callback patch-another();
    callback patch-changed(int);
    // The patch whose row is under the pointer, -1 for none: its
    // outline drawn while it is.
    in-out property <int> patch-lit: -1;
    callback lit-changed();
    changed patch-names => { root.patch-lit = -1; root.lit-changed(); }
    init => { root.patch-lit = -1; }
    callback delete-patch();
    callback patch-edited();

    title: @tr("RETOUCH");
    icon: @image-url("../icons/bandage.svg");
    collapsed <=> root.collapsed-retouch;
    switchable: true;
    on <=> root.retouch-enabled;
    switched => { root.develop-changed(); }
    HorizontalLayout {
        spacing: Theme.space-2;
        PanelButton {
            text: @tr("Heal");
            icon: @image-url("../icons/bandage.svg");
            primary: root.retouch-mode == "Heal";
            clicked => { root.retouch-toggled("Heal"); }
        }
        PanelButton {
            text: @tr("Clone");
            icon: @image-url("../icons/stamp.svg");
            primary: root.retouch-mode == "Clone";
            clicked => { root.retouch-toggled("Clone"); }
        }
        PanelButton {
            text: @tr("Fill");
            icon: @image-url("../icons/sparkles.svg");
            primary: root.retouch-mode == "Fill";
            clicked => { root.retouch-toggled("Fill"); }
        }
    }
    if root.retouch-mode != "": VerticalLayout {
        spacing: Theme.space-2;
        EditSlider {
            label: @tr("Size");
            minimum: 0.002;
            maximum: 0.3;
            default: 0.02;
            step: 0.001;
            steps: Steps.thousandths;
            value <=> root.patch-size;
            scale: 100;
            text: round(root.patch-size * 1000) / 10 + "%";
            changed(v) => { root.patch-edited(); }
        }
        EditSlider {
            label: @tr("Feather");
            minimum: 0;
            maximum: 1;
            default: 0.3;
            step: 0.01;
            steps: Steps.percent;
            value <=> root.patch-feather;
            scale: 100;
            text: round(root.patch-feather * 100) + "%";
            changed(v) => { root.patch-edited(); }
        }
        EditSlider {
            label: @tr("Opacity");
            minimum: 0;
            maximum: 1;
            default: 1;
            step: 0.01;
            steps: Steps.percent;
            value <=> root.patch-opacity;
            scale: 100;
            text: round(root.patch-opacity * 100) + "%";
            changed(v) => { root.patch-edited(); }
        }
    }
    if root.fill-shown: Segmented {
        options: ["Patch", "Fast", "Best"];
        labels: [@tr("Patch"), @tr("Fast"), @tr("Best")];
        tips: [@tr("From the picture around it, at once"), @tr("The remove in four steps: quicker, rougher on large areas"), @tr("The remove in full")];
        why-not: root.fill-why-not;
        current: root.fill-choice;
        picks: false;
        accessible-role: list;
        // Spoken as the label shown.
        accessible-value: self.current == "Patch" ? @tr("Patch")
            : self.current == "Fast" ? @tr("Fast")
            : self.current == "Best" ? @tr("Best")
            : self.current;
        selected(c) => { root.fill-chosen(c); }
    }
    if root.patch-names.length > 0: Rectangle {
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 2px;
            spacing: 2px;
            for name[i] in root.patch-names: Rectangle {
                property <bool> on: i == root.patch;
                height: Theme.control-height;
                border-radius: Theme.radius-sm;
                background: on ? Theme.raised : (prow.has-hover ? Theme.hover : transparent);
                animate background { duration: Theme.quick; }
                // The row's buttons inside it, so the row keeps its
                // hover over them.
                prow := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.patch-lit = i;
                        } else if (root.patch-lit == i) {
                            root.patch-lit = -1;
                        }
                        root.lit-changed();
                    }
                    clicked => { root.patch-changed(i); }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        Text {
                            text: name;
                            color: on ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if on && root.patch-varies: PanelButton {
                            // Fill: another variation of the fill
                            text: @tr("Another");
                            height: Theme.control-height - 4px;
                            y: 2px;
                            clicked => { root.patch-another(); }
                        }
                        if on: Rectangle {
                            width: Theme.control-height - 4px;
                            accessible-role: button;
                            accessible-label: @tr("Remove {}", name);
                            accessible-action-default => { root.delete-patch(); }
                            Image {
                                source: @image-url("../icons/trash-2.svg");
                                colorize: pbin.has-hover ? Theme.text : Theme.text-secondary;
                                width: Theme.icon;
                                height: Theme.icon;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            pbin := TipArea {
                                words: @tr("Remove");
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.delete-patch(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
