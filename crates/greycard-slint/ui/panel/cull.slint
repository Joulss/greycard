// The CULLING section: the mode's keys, the frame's turn, the
// browser's filter, the compare view and the two ways out.

import { Theme } from "../theme.slint";
import { FilterChip, FacetRow, SortMenu } from "../structs.slint";
import { Section, PanelButton, Segmented, Toggle } from "../controls.slint";
import { FilterBar } from "filter.slint";

export component CullSection inherits Section {
    /// The export queue's view: no rejects folder to delete.
    in property <bool> queue-view;
    /// Drawn developed rather than from the camera's JPEG, and the
    /// switch between the two.
    in property <bool> developed;
    callback source-asked(bool);
    callback frame-turned(int);
    in-out property <bool> grid-open;
    callback cull-leave();
    in-out property <string> compare-text;
    callback compare-changed(int);
    in-out property <bool> move-on;
    callback move-on-changed();
    in-out property <[FilterChip]> filter-stars;
    in-out property <[FilterChip]> filter-flags;
    in-out property <[FilterChip]> filter-labels;
    in-out property <bool> filter-exact;
    in-out property <string> filter-text;
    in-out property <int> filter-shown;
    in-out property <int> filter-total;
    in-out property <bool> filter-on;
    in-out property <bool> filter-focus;
    /// Whether the filter bar is shown here; off, the filter set
    /// still applies.
    in property <bool> filter-bar: true;
    in property <[FacetRow]> filter-facets;
    in property <string> filter-facet-note;
    callback filter-facet-toggled(int, string, bool);
    in-out property <bool> collapsed-culling;
    callback filter-star-picked(int);
    callback filter-flag-toggled(int, bool);
    callback filter-label-toggled(int, bool);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    /// The bar's Sort menu, and its two picks.
    in property <SortMenu> sort-menu;
    callback sort-picked(int);
    callback sort-turned(bool);
    in property <int> reject-count;
    callback rejects-asked();
    /// Move back: the frames of the selection in a rejects folder, and
    /// the folder above by name.
    in property <int> back-count;
    in property <string> back-to;
    callback move-back();
    callback delete-asked(string);
    /// "Remove rejects from Archive...", one an archive (§216).
    in property <[string]> archive-rejects-choices;
    callback archive-rejects-asked(int);
    callback focus-keys();

    title: @tr("CULLING");
    icon: @image-url("../icons/image.svg");
    hint: "C";
    collapsed <=> root.collapsed-culling;
    // What the picture is drawn from: the camera's JPEG, instant from
    // frame to frame, or the frame developed, for checking edits at
    // full size without the edit panel. In a panel too narrow for the
    // label and both buttons whole beside it, the label goes over them,
    // as the filter's group names do.
    property <bool> picture-over: 68px + 2 * Theme.space-2 + camera-jpeg.preferred-width
        + developed.preferred-width > self.width - self.padding-left - self.padding-right;
    if root.picture-over: Text { text: @tr("Picture"); color: Theme.text; font-size: Theme.font-sm; }
    HorizontalLayout {
        spacing: Theme.space-2;
        if !root.picture-over: Text { text: @tr("Picture"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        camera-jpeg := PanelButton {
            text: @tr("Camera JPEG");
            primary: !root.developed;
            accessible-role: button;
            accessible-label: @tr("Camera JPEG pictures");
            accessible-checked: !root.developed;
            clicked => { root.focus-keys(); root.source-asked(false); }
        }
        developed := PanelButton {
            text: @tr("Developed");
            primary: root.developed;
            accessible-role: button;
            accessible-label: @tr("Developed pictures");
            accessible-checked: root.developed;
            clicked => { root.focus-keys(); root.source-asked(true); }
        }
    }
    Text {
        text: root.developed ? @tr("1-5 stars · P pick · X reject · U unflag · 6-9 label · Space 1:1 · Enter develops")
            : @tr("1-5 stars · P pick · X reject · U unflag · 6-9 label · Space 1:1 · V compare · Enter develops");
        font-size: Theme.font-xs;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    // The frame's own turn, for the shot the
    // camera's tag got wrong. Nothing develops.
    HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: @tr("Turn"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        PanelButton {
            text: @tr("Left");
            icon: @image-url("../icons/rotate-ccw.svg");
            words: @tr("Turn the frame left");
            clicked => { root.frame-turned(-1); }
        }
        PanelButton {
            text: @tr("Right");
            icon: @image-url("../icons/rotate-cw.svg");
            words: @tr("Turn the frame right");
            clicked => { root.frame-turned(1); }
        }
    }
    // The same filter the grid's header holds,
    // a group of chips to a row: the panel,
    // 280px at its narrowest, could not hold
    // the header's one row.
    if root.filter-bar: Text {
        text: @tr("Show");
        color: Theme.text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
    if root.filter-bar: FilterBar {
        stacked: true;
        takes-focus: !root.grid-open;
        wanted <=> root.filter-focus;
        stars: root.filter-stars;
        flags: root.filter-flags;
        labels: root.filter-labels;
        facets: root.filter-facets;
        facet-note: root.filter-facet-note;
        facet-toggled(c, k, x) => { root.filter-facet-toggled(c, k, x); }
        exact: root.filter-exact;
        shown: root.filter-shown;
        total: root.filter-total;
        on: root.filter-on;
        text <=> root.filter-text;
        star-picked(i) => { root.filter-star-picked(i); }
        flag-toggled(i, x) => { root.filter-flag-toggled(i, x); }
        label-toggled(i, x) => { root.filter-label-toggled(i, x); }
        exact-toggled => { root.filter-exact-toggled(); }
        text-edited(t) => { root.filter-text-edited(t); }
        cleared => { root.filter-cleared(); }
        released => { root.focus-keys(); }
        sort: root.sort-menu;
        sort-picked(i) => { root.sort-picked(i); }
        sort-turned(d) => { root.sort-turned(d); }
    }
    // The compare view is the camera JPEG's alone.
    if !root.developed: HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: @tr("Compare"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        Segmented {
            // Three is shown only while Compare versions has put the
            // view at three; it is never offered otherwise.
            options: root.compare-text == "3" ? ["1", "2", "3", "4"] : ["1", "2", "4"];
            current <=> root.compare-text;
            selected(c) => { root.compare-changed(c == "2" ? 2 : c == "3" ? 3 : c == "4" ? 4 : 1); }
        }
    }
    // One press instead of two: the key and then the arrow. Off
    // until asked for, and the keys go back to the picture after
    // the press, as the filter's chips give them back.
    Toggle {
        label: @tr("Move on after a rating, flag or label");
        checked <=> root.move-on;
        toggled => { root.move-on-changed(); root.focus-keys(); }
    }
    PanelButton {
        text: root.reject-count == 0 ? @tr("No rejects to move")
            : @tr("Move {n} reject..." | "Move {n} rejects..." % root.reject-count);
        icon: @image-url("../icons/folder-open.svg");
        enabled: root.reject-count > 0;
        clicked => { root.rejects-asked(); }
    }
    // The way back, for a frame in a rejects folder: no sheet, since
    // nothing is written over and the frame can go out again.
    if root.back-count > 0: PanelButton {
        text: root.back-count > 1
            ? @tr("Move {n} frame back to {}" | "Move {n} frames back to {}" % root.back-count, root.back-to)
            : @tr("Move back to {}", root.back-to);
        icon: @image-url("../icons/folder-open.svg");
        clicked => { root.move-back(); }
    }
    // Deleting, beside moving: each opens a sheet that names the
    // count and the folder, and nothing goes until it is answered.
    PanelButton {
        text: @tr("Delete selection...");
        icon: @image-url("../icons/trash-2.svg");
        clicked => { root.delete-asked("selection"); }
    }
    PanelButton {
        text: @tr("Delete rejects folder...");
        icon: @image-url("../icons/trash-2.svg");
        enabled: !root.queue-view;
        clicked => { root.delete-asked("rejects"); }
    }
    // The rejects' copies on an archive, found by hash: moved into a
    // rejects folder there, or deleted from it, behind a sheet.
    for choice[i] in root.archive-rejects-choices: PanelButton {
        text: choice;
        icon: @image-url("../icons/folder-open.svg");
        clicked => { root.archive-rejects-asked(i); }
    }
    PanelButton {
        text: @tr("Develop");
        icon: @image-url("../icons/sliders-horizontal.svg");
        primary: true;
        clicked => { root.cull-leave(); }
    }
}
