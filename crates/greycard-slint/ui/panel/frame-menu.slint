// The frame menu: what a right-click over a frame in the strip, the
// grid or the viewport offers, on the whole selection. Slint's own
// context menu, native where the platform has one (macOS, Windows)
// and drawn by Slint in the window's style elsewhere. It is one menu
// for the window, not one per cell: the surfaces say where the click
// was, in the window's coordinates, and `open` puts it there. Every
// item goes through the code its key does; this file only names them.

export component FrameMenu inherits Rectangle {
    /// How many frames the menu acts on, the current one among them.
    in property <int> count: 1;
    /// The frame right-clicked, whose settings Copy takes.
    in property <string> file;
    /// The frame the clipboard holds settings from; empty when
    /// nothing has been copied, and Paste is grayed.
    in property <string> paste-from;
    /// How many frames a paste goes onto: the selection, less the
    /// frame the settings came from when it is in it.
    in property <int> paste-count;
    /// Whether any frame is chosen for a rating, a flag or a label to
    /// reach: none is, in the loupe under a filter that hides them all.
    in property <bool> can-meta: true;
    /// What the whole selection shares, for the checks: the stars, the
    /// flag's code and the label's code; -1 when the frames differ.
    in property <int> rating: -1;
    in property <int> flag: -1;
    in property <int> label: -1;
    /// Whether Export... can be asked for: a frame open, not culling,
    /// no export under way. A develop in progress does not gray it;
    /// the sheet waits for the develop instead.
    in property <bool> can-export;
    /// "Back up" over the selection to an archive, or "Bring back" from
    /// one to a local root; empty when neither is offered here. The
    /// choices are the archives, or the local roots, by name.
    in property <string> archive-verb;
    in property <[string]> archive-choices;
    callback archive(int);
    /// How many of the selection are in a rejects folder, and the
    /// folder above it by name, for Move back; none leaves it out.
    in property <int> back-count;
    in property <string> back-to;
    callback move-back();
    /// The collections filled by hand, by name, for Add to collection;
    /// the one open in the browser, by name, for Remove from it, empty
    /// when no collection is open.
    in property <[string]> collections;
    in property <string> collection-open;
    /// Added to the collection at that place in `collections`, or to a
    /// new one for -1.
    callback collection-add(int);
    callback collection-remove();
    callback copy();
    callback paste();
    /// A rating, a flag or a label ("rating", "flag", "label") and its
    /// value: the stars, or the flag's or label's code.
    callback meta(string, int);
    /// The shift-capture-time sheet over the selection.
    callback time-shift();
    callback reveal();
    callback export();
    /// The apps Edit in hands the frame to, by name: one is an item of
    /// its own, more a submenu of them, and none leaves it out.
    in property <[string]> edit-in-apps;
    callback edit-in(int);
    /// The sync sheet over the selection, from the frame on screen:
    /// offered with more than one frame chosen, as Ctrl+Shift+S is.
    callback sync();
    /// Every edit of the selection back to the Original, a step on
    /// each frame that moves.
    callback reset();
    /// The frame on screen, which a sync takes its settings from.
    in property <string> current;
    /// Whether the lightbox is on, for its item's words, and the item.
    in property <bool> lightbox;
    callback lightbox-toggled();
    /// The version the frame right-clicked is, by name; empty for the
    /// file's own, which Rename, Swap and Delete are not offered on.
    in property <string> version;
    /// Whether a version can be made here: a frame, not culling.
    in property <bool> can-version: true;
    /// New version (Ctrl+'), the frame's edit copied; from the
    /// original, the default edit.
    callback new-version();
    callback new-version-from-original();
    callback rename-version();
    callback swap-version();
    callback delete-version();
    /// The export queue's view: what would write an edit is off, and
    /// the frames are taken out of the queue rather than deleted.
    in property <bool> queue;
    callback queue-remove();
    /// Whether the frame right-clicked is a file with versions or a
    /// version of one: Compare versions is offered on it.
    in property <bool> can-compare;
    callback compare-versions();
    /// The stack the frame right-clicked is in: how many frames it
    /// shows, 0 for none; whether it is open; whether the frame is its
    /// top. And whether the frames chosen can be made a stack.
    in property <int> stack;
    in property <bool> stack-open;
    in property <bool> stack-top;
    in property <bool> can-stack;
    /// How many frames that stack would hold: a closed stack's top
    /// chosen brings its stack.
    in property <int> stack-holds;
    callback stack-make();
    callback stack-unmake();
    callback stack-toggle();
    callback stack-top-asked();
    callback stack-remove();
    callback stack-compare();
    /// Stack bursts, over the folders listed rather than the frame.
    callback stack-bursts();
    /// Merge to HDR, over the selection: offered with more than one
    /// frame chosen.
    callback merge-hdr();
    /// Merge to Panorama, the same.
    callback merge-pano();
    /// Merge to Focus stack, the same.
    callback merge-focus();

    // Nothing of its own to draw or to take a click: the menu is a
    // popup, placed from this corner, and a zero-sized area at the
    // window's origin never stands in front of anything.
    width: 0px;
    height: 0px;

    /// Open the menu at (x, y), the window's logical pixels.
    public function open(x: length, y: length) {
        area.show({ x: x - self.absolute-position.x, y: y - self.absolute-position.y });
    }

    area := ContextMenuArea {
        // The surfaces open it; a right-click on this zero-sized
        // corner is never one.
        enabled: false;
        Menu {
            MenuItem {
                title: root.file == "" ? @tr("Copy settings") : @tr("Copy settings of {}", root.file);
                activated => { root.copy(); }
            }
            // Named for what they do to the selection: a paste onto
            // how many, a sync of how many to which, as the sync
            // sheet's words and the develop panel's button say it.
            MenuItem {
                title: root.paste-from == "" ? @tr("Paste settings")
                    : root.paste-count < 1 ? @tr("Paste settings from {}", root.paste-from)
                    : @tr("Paste settings from {} onto {n} frame..." | "Paste settings from {} onto {n} frames..." % root.paste-count, root.paste-from);
                enabled: root.paste-from != "" && !root.queue;
                activated => { root.paste(); }
            }
            if root.count > 1: MenuItem {
                enabled: !root.queue;
                title: @tr("Sync {n} frame to {}..." | "Sync {n} frames to {}..." % (root.count - 1),
                    // Fills {} in 'Sync N frames to {}...' for an unnamed open frame
                    root.current == "" ? @tr("this one") : root.current);
                activated => { root.sync(); }
            }
            if !root.queue: MenuItem {
                title: @tr("Reset to Original");
                activated => { root.reset(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("New version");
                enabled: root.can-version;
                activated => { root.new-version(); }
            }
            MenuItem {
                title: @tr("New version from the original");
                enabled: root.can-version;
                activated => { root.new-version-from-original(); }
            }
            if root.version != "": MenuItem {
                title: @tr("Rename version...");
                enabled: !root.queue;
                activated => { root.rename-version(); }
            }
            if root.version != "": MenuItem {
                title: @tr("Swap with the original");
                enabled: !root.queue;
                activated => { root.swap-version(); }
            }
            if root.version != "" && !root.queue: MenuItem {
                title: @tr("Delete version...");
                activated => { root.delete-version(); }
            }
            if root.can-compare: MenuItem {
                title: @tr("Compare versions");
                activated => { root.compare-versions(); }
            }
            MenuSeparator { }
            // The stack's items, on Lightroom's keys where it has them
            // (Ctrl+G, S, Shift+S, Ctrl+Shift+G).
            if root.can-stack: MenuItem {
                title: @tr("Stack {n} frame" | "Stack {n} frames" % root.stack-holds);
                activated => { root.stack-make(); }
            }
            if root.stack > 0: MenuItem {
                title: root.stack-open ? @tr("Collapse stack") : @tr("Expand stack");
                activated => { root.stack-toggle(); }
            }
            if root.stack > 0 && !root.stack-top: MenuItem {
                title: @tr("Set as top of stack");
                activated => { root.stack-top-asked(); }
            }
            if root.stack > 0: MenuItem {
                title: @tr("Remove from stack");
                activated => { root.stack-remove(); }
            }
            if root.stack > 0: MenuItem {
                title: @tr("Compare stack");
                activated => { root.stack-compare(); }
            }
            if root.stack > 0: MenuItem {
                title: @tr("Unstack");
                activated => { root.stack-unmake(); }
            }
            if !root.queue: MenuItem {
                title: @tr("Stack bursts");
                activated => { root.stack-bursts(); }
            }
            if !root.queue && root.count > 1: MenuItem {
                title: @tr("Merge to HDR");
                activated => { root.merge-hdr(); }
            }
            if !root.queue && root.count > 1: MenuItem {
                title: @tr("Merge to Panorama");
                activated => { root.merge-pano(); }
            }
            if !root.queue && root.count > 1: MenuItem {
                title: @tr("Merge to Focus stack");
                activated => { root.merge-focus(); }
            }
            if root.can-stack || root.stack > 0 || !root.queue: MenuSeparator { }
            MenuItem {
                title: root.lightbox ? @tr("Leave lightbox") : @tr("Lightbox");
                activated => { root.lightbox-toggled(); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Rating");
                enabled: root.can-meta;
                for n in 6: MenuItem {
                    title: n == 0 ? @tr("No stars") : @tr("{n} star" | "{n} stars" % n);
                    checkable: true;
                    checked: root.rating == n;
                    enabled: root.can-meta;
                    activated => { root.meta("rating", n); }
                }
            }
            MenuItem {
                title: @tr("Pick");
                checkable: true;
                checked: root.flag == 1;
                enabled: root.can-meta;
                activated => { root.meta("flag", 1); }
            }
            MenuItem {
                title: @tr("Reject");
                checkable: true;
                checked: root.flag == 2;
                enabled: root.can-meta;
                activated => { root.meta("flag", 2); }
            }
            MenuItem {
                title: @tr("Unflag");
                enabled: root.can-meta && root.flag != 0;
                activated => { root.meta("flag", 0); }
            }
            Menu {
                title: @tr("Label");
                enabled: root.can-meta;
                // Label menu: the fifth label; the four others are in Color
                for name[n] in [@tr("None"), @tr("Red"), @tr("Yellow"), @tr("Green"), @tr("Blue"), @tr("Purple")]: MenuItem {
                    title: name;
                    checkable: n > 0;
                    checked: n > 0 && root.label == n;
                    enabled: root.can-meta && (n > 0 || root.label != 0);
                    activated => { root.meta("label", n); }
                }
            }
            MenuItem {
                title: root.count > 1 ? @tr("Shift capture time of {n} frame..." | "Shift capture time of {n} frames..." % root.count)
                    : @tr("Shift capture time...");
                enabled: root.can-meta;
                activated => { root.time-shift(); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Add to collection");
                for name[i] in root.collections: MenuItem {
                    title: name;
                    activated => { root.collection-add(i); }
                }
                if root.collections.length > 0: MenuSeparator { }
                MenuItem {
                    title: @tr("New collection...");
                    activated => { root.collection-add(-1); }
                }
            }
            if root.collection-open != "": MenuItem {
                title: root.count > 1
                    ? @tr("Remove {n} frame from {}" | "Remove {n} frames from {}" % root.count, root.collection-open)
                    : @tr("Remove from {}", root.collection-open);
                activated => { root.collection-remove(); }
            }
            if root.queue: MenuItem {
                title: @tr("Remove from queue...");
                activated => { root.queue-remove(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Reveal in file manager");
                activated => { root.reveal(); }
            }
            MenuItem {
                title: root.count > 1 ? @tr("Export {n} frame..." | "Export {n} frames..." % root.count) : @tr("Export...");
                enabled: root.can-export;
                activated => { root.export(); }
            }
            if root.edit-in-apps.length == 1: MenuItem {
                title: @tr("Edit in...");
                enabled: root.can-export;
                activated => { root.edit-in(0); }
            }
            if root.edit-in-apps.length > 1: Menu {
                title: @tr("Edit in");
                for name[i] in root.edit-in-apps: MenuItem {
                    title: name;
                    enabled: root.can-export;
                    activated => { root.edit-in(i); }
                }
            }
            if root.back-count > 0: MenuItem {
                title: root.back-count > 1
                    ? @tr("Move {n} frame back to {}" | "Move {n} frames back to {}" % root.back-count, root.back-to)
                    : @tr("Move back to {}", root.back-to);
                activated => { root.move-back(); }
            }
            if root.archive-verb != "" && root.archive-choices.length == 1: MenuItem {
                // Frame menu: {} is Back up or Bring back, then an archive's name
                title: @tr("{} to {}...", root.archive-verb, root.archive-choices[0]);
                activated => { root.archive(0); }
            }
            if root.archive-verb != "" && root.archive-choices.length > 1: Menu {
                // Frame menu: {} is Back up or Bring back, over a list of archives
                title: @tr("{} to", root.archive-verb);
                for name[i] in root.archive-choices: MenuItem {
                    title: name + "...";
                    activated => { root.archive(i); }
                }
            }
        }
    }
}
