// The viewport: the engine's texture, the pointer on it, and what is
// drawn over the picture in view pixels, from the brush and the dropper
// to the crop, the masks' shapes, the repairs and the status plate.

import { Theme } from "../theme.slint";
import { SliderKeys } from "../controls.slint";
import { Pt, MaskBox, MaskPick, PersonBox, CompareTile } from "../structs.slint";
import { CropHandle, ThumbBadges, PanelButton, TipArea } from "../controls.slint";

// The dark copy under a light stroke over the viewport: wider, so it
// edges the stroke where the stroke runs over the white canvas, and
// over a white sky too. The dropper's icon carries one the same way.
global Halo {
    out property <color> ink: #00000080;
    out property <length> width: 3px;
}

// An ellipse's outline, in the view's own pixels, turned by `angle`
// degrees about its center: the brush's ring and the repair's are
// circles of it, the radial shape's edge an ellipse. `halo` draws the
// dark copy under it.
component Ring inherits Rectangle {
    in property <float> cx;
    in property <float> cy;
    in property <float> rx;
    in property <float> ry;
    in property <float> angle;
    in property <color> stroke;
    in property <bool> halo;
    property <float> ca: cos(root.angle * 1deg);
    property <float> sa: sin(root.angle * 1deg);
    for under in root.halo ? [true, false] : [false]: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: under ? Halo.ink : root.stroke;
        stroke-width: under ? Halo.width : 1px;
        MoveTo { x: root.cx + root.rx * root.ca; y: root.cy + root.rx * root.sa; }
        ArcTo { x: root.cx - root.rx * root.ca; y: root.cy - root.rx * root.sa; radius-x: root.rx; radius-y: root.ry; x-rotation: root.angle; large-arc: false; sweep: true; }
        ArcTo { x: root.cx + root.rx * root.ca; y: root.cy + root.rx * root.sa; radius-x: root.rx; radius-y: root.ry; x-rotation: root.angle; large-arc: false; sweep: true; }
    }
}

// A straight rule from one point to another, in view pixels, with the
// same dark copy under it when `halo`.
component Rule inherits Rectangle {
    in property <float> x0;
    in property <float> y0;
    in property <float> x1;
    in property <float> y1;
    in property <color> stroke;
    in property <bool> halo;
    for under in root.halo ? [true, false] : [false]: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: under ? Halo.ink : root.stroke;
        stroke-width: under ? Halo.width : 1px;
        MoveTo { x: root.x0; y: root.y0; }
        LineTo { x: root.x1; y: root.y1; }
    }
}

// A grid of screen-aligned lines a fixed way apart, laid over the
// picture while its angle is being set, so a horizon or an edge can be
// brought level by eye against the nearest line. Every fourth line is
// brighter, to count by.
component AlignGrid inherits Rectangle {
    property <length> pitch: 32px;
    property <int> cols: floor(root.width / root.pitch);
    property <int> rows: floor(root.height / root.pitch);
    for i in root.cols: Rectangle {
        x: (i + 1) * root.pitch; y: 0; width: 1px; height: 100%;
        background: mod(i + 1, 4) == 0 ? #ffffff80 : #ffffff40;
    }
    for i in root.rows: Rectangle {
        x: 0; y: (i + 1) * root.pitch; width: 100%; height: 1px;
        background: mod(i + 1, 4) == 0 ? #ffffff80 : #ffffff40;
    }
}

export component Viewport inherits Rectangle {
    /// A name is being typed in a panel's text box: the pointer
    /// crossing the picture leaves the keys where they are.
    in property <bool> typing: false;
    callback zoom(float, length, length);
    callback pan(length, length);
    /// Whether a point of the view lies on the picture as placed, not
    /// on the canvas round it: only a drag that starts on it pans.
    pure callback picture-at(length, length) -> bool;
    /// A touchpad's scroll: the picture follows the fingers, held
    /// at its edges, and still where it fits the view.
    callback wheel-pan(length, length);
    callback toggle-zoom(length, length);
    /// A middle click on the picture: 200% there, or back to the zoom
    /// it came from.
    callback toggle-zoom-200(length, length);
    /// The pointer over the view, and where, for the color under it
    /// on the scopes; false when it leaves.
    callback hovered(bool, length, length);
    /// The dropper drawn at the pointer while picking. Empty if the
    /// icon is missing, and then the cursor stays a crosshair.
    property <image> dropper: @image-url("../icons/pipette.svg");
    in property <bool> placeholder;
    // The frame's Original shows in place of the edit: the tools'
    // overlays are hidden, as over the placeholder, and a press with
    // a tool in hand turns the edit back rather than act on a picture
    // it is not.
    in property <bool> original: false;
    callback original-off();
    property <bool> bare: root.placeholder || root.original;
    in property <[CompareTile]> compare-tiles;
    /// Culling: the frame on screen's badge in the corner, or one on
    /// each compared tile, and a word for the last key pressed.
    in property <bool> culling;
    /// Out of culling: the frame's badge over the picture, as
    /// culling's, while this is true, and fading out after.
    in property <bool> develop-badge;
    /// While the soft proof is on: its name for a pill in the corner,
    /// and a click on the pill turns it off. Empty for none.
    in property <string> proof-badge;
    callback proof-off();
    in property <int> frame-rating;
    in property <int> frame-flag;
    in property <int> frame-label;
    in property <int> meta-stars: 5;
    in property <string> notice;
    in property <bool> notice-on;
    in-out property <bool> crop-mode;
    in-out property <bool> level-mode;
    in-out property <string> guide-mode;
    in-out property <string> panel-tab;
    in-out property <string> placing;
    in-out property <float> brush-size;
    in-out property <float> brush-feather;
    in-out property <string> brush-op;
    in-out property <float> brush-scale;
    in-out property <string> picking;
    // The color pick's square: its side in the picture's pixels, and
    // a picture pixel's side on the view.
    in property <int> range-sample: 5;
    in property <float> pick-scale: 1;
    // A color wheel in hand: a Ctrl-click takes its hue from the
    // picture, with Shift the complement, and does nothing else.
    in property <bool> wheel-in-hand;
    callback wheel-pick(length, length, bool);
    callback pick-pressed(length, length);
    callback pick-dragged(length, length);
    callback pick-released();
    callback place-pressed(length, length, bool);
    callback place-dragged(length, length);
    callback place-released();
    // Shift at the press that places a shape, and on every move of
    // its drag after: a linear held to steps of its angle, a radial
    // to a circle.
    in-out property <bool> place-shift;
    // The middle button held in a left drag placing a gradient or a
    // brush: a linear or a radial held as Shift holds it, a brush's
    // stroke a straight line from its press. Read on every drag.
    in-out property <bool> place-line;
    property <bool> line-tool: root.placing == "Linear" || root.placing == "Radial" || root.placing == "Brush";
    // Whether Shift holds the shape in hand, and so is not the hand.
    out property <bool> shift-holds: root.placing == "Linear" || root.placing == "Radial";
    in-out property <string> mask-kind;
    in-out property <[Pt]> mask-handles;
    // The handles put down by Esc: none drawn, and a press on the
    // shape's body brings them back.
    in-out property <bool> handles-down;
    in-out property <[MaskBox]> mask-boxes;
    in-out property <[MaskPick]> mask-picks;
    in-out property <[PersonBox]> person-boxes;
    /// Everyone's, while a person is to be picked for a part.
    callback all-people();
    in-out property <float> mask-angle;
    in-out property <float> mask-rx;
    in-out property <float> mask-ry;
    in-out property <float> mask-feather-scale;
    // Shift at the handle's press: the shape held as it is placed.
    callback mask-grabbed(int, bool);
    // Alt as the handle's own pointer event reported it on this move
    // (`CropHandle.alt`), so a linear gradient's end can choose pivot
    // (plain) or free-end (Alt) rotation; and Shift likewise
    // (`CropHandle.shift`), so a hold taken or let go mid-drag acts on
    // the next move.
    callback mask-dragged(int, length, length, bool, bool);
    callback mask-dropped();
    /// Whether a point of the view lies on the chosen shape's body,
    /// where a drag moves the whole shape as its center handle does.
    /// The third argument is `mask-shape-key`, passed only so the
    /// cursor's binding follows a change to the shape.
    pure callback mask-body-at(length, length, float) -> bool;
    // The drawn handles summed: read by the cursor's binding only so
    // the binding depends on the handle rows, and an undo or a panel
    // edit that moves the shape under a still pointer asks again. The
    // value itself proves nothing; a changed row re-runs the binding.
    property <float> mask-shape-key: root.mask-handles.length
        + root.mask-handles[0].x + root.mask-handles[0].y
        + root.mask-handles[1].x + root.mask-handles[1].y
        + root.mask-handles[2].x + root.mask-handles[2].y
        + root.mask-handles[3].x + root.mask-handles[3].y;
    // Whether a drag on a shape's body is moving it, for the window.
    out property <bool> mask-body-moving: ta.body-moving;
    // A linear or radial shape chosen with no tool in hand: the only
    // time a press on the picture can take hold of a shape's body.
    property <bool> mask-body-live: (root.mask-kind == "Linear" || root.mask-kind == "Radial")
        && !root.bare && root.picking == "" && root.placing == ""
        && root.retouch-mode == "" && !root.crop-mode && !root.level-mode
        && root.guide-mode == "";
    in property <length> crop-left;
    in property <length> crop-top;
    in property <length> crop-width;
    in property <length> crop-height;
    /// The Angle slider in a drag: the grid is laid on, over the crop
    /// when the crop is in hand, else over the whole view.
    in property <bool> angle-dragging;
    callback crop-pressed(int);
    callback crop-dragged(int, length, length);
    callback crop-released();
    // A press outside the crop, on the picture: drawing a new one
    // from there rather than resizing or moving the one there is.
    callback crop-draw-pressed(length, length);
    callback crop-draw-dragged(length, length);
    callback crop-draw-released();
    // A double-click inside the crop, as in Lightroom: the crop is
    // done, as the CROP section's button would make it (issue 74).
    callback crop-done();
    // Draw in hand (the CROP section's button): the crop's handles
    // stand aside, so the next press anywhere on the picture, inside
    // the crop too, reaches the picture's own area and a drag there
    // draws; its release, or a click that never dragged, puts it down.
    in-out property <bool> crop-draw-armed;
    callback level-end(length, length, length, length);
    callback guide-stroke(length, length, length, length);
    in property <[Pt]> guide-kept;
    in property <string> status;
    in property <string> sync-note;
    callback sync-retry();
    in property <string> placeholder-status;
    /// The plate put away with the panels, by Tab.
    in property <bool> plate-hidden: false;
    in-out property <int> canvas-choice;
    in property <[color]> canvas-colors;
    /// A light surround (white): the plates and badges, which often
    /// sit on it rather than on the picture, take a denser scrim, so
    /// their words read on it as they do on black.
    in property <bool> canvas-light;
    property <color> plate-ground: root.canvas-light ? Theme.over-plate-dense : #00000099;
    in property <bool> busy;
    in-out property <string> retouch-mode;
    in-out property <float> patch-size;
    in-out property <float> patch-feather;
    in-out property <int> patch;
    in-out property <[Pt]> patch-handles;
    in property <string> patch-outline;
    in property <string> patch-feather-outline;
    in property <string> pending-outline;
    in property <float> fill-fraction: -1;
    // The plate's bar counts the fill at work's steps, unless a
    // develop is on its way.
    property <bool> filling: root.fill-fraction >= 0 && !root.busy;
    callback patch-changed(int);
    callback patch-edited();
    callback patch-grabbed(int);
    callback patch-dragged(int, length, length);
    callback patch-dropped();
    callback focus-keys();
    /// A right-click on the picture (or, on a Mac, a Control+click)
    /// with no tool in hand: the frame menu, over the frame on
    /// screen, where the click was in the window's logical pixels.
    callback frame-menu(length, length);
    /// Whether the frame menu is up: the press that closes it is not
    /// a click on the picture.
    pure callback menu-shown() -> bool;
    in property <bool> ctrl-click-menu;
    /// Space or Shift held over a tool that paints or places on the
    /// picture: a drag pans instead, and the cursor is the hand.
    /// Shift is read off the press too, for a key held since before
    /// the window had the keys.
    in property <bool> hand;
    /// Set when such a drag panned, for Space's release: a tap still
    /// zooms, a hold that panned does not.
    in-out property <bool> hand-panned;
    // A tool that acts on a press on the picture.
    property <bool> tool-held: root.placing != "" || root.picking != "" || root.retouch-mode != ""
        || root.crop-mode || root.level-mode || root.guide-mode != "" || root.crop-draw-armed;
    property <bool> hand-tool: !root.placeholder && (root.placing != "" || root.retouch-mode != "");
    // The middle button pans the picture whatever is in hand, the tool
    // left as it is: a drag of it from wherever on the view had its
    // press, the picture's own area, a handle, the crop, the level, or
    // the guide. As a left drag does, it pans only from a press on the
    // picture.
    property <bool> mid-down;
    property <bool> mid-dragged;
    property <bool> mid-canvas;
    property <length> mid-x;
    property <length> mid-y;
    property <length> mid-last-x;
    property <length> mid-last-y;
    // Whether the picture's own area had the press, rather than an
    // area over it, which a key can take away mid-pan with no word.
    property <bool> mid-view;
    // A middle press, a move while it is held, its release, or the
    // window letting go of it, at a point in the view's own
    // coordinates, from the picture's own area (`view`) or another.
    // Another button's release while it pans takes the window's hold
    // on the pan with it, and ends it.
    function middle-event(e: PointerEvent, x: length, y: length, view: bool) {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.middle) {
            root.focus-keys();
            root.mid-down = true;
            root.mid-view = view;
            root.mid-dragged = false;
            root.mid-canvas = !root.picture-at(x, y);
            root.mid-x = x;
            root.mid-y = y;
            root.mid-last-x = x;
            root.mid-last-y = y;
        } else if (e.kind == PointerEventKind.move && root.mid-down) {
            if (abs(x - root.mid-x) > 4px || abs(y - root.mid-y) > 4px) {
                root.mid-dragged = true;
            }
            if (root.mid-dragged && !root.mid-canvas) {
                root.pan(x - root.mid-last-x, y - root.mid-last-y);
            }
            root.mid-last-x = x;
            root.mid-last-y = y;
        } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle && root.mid-down) {
            root.mid-down = false;
            // A click that did not drag: 200% here, or back.
            if (!root.mid-dragged && !root.mid-canvas) {
                root.toggle-zoom-200(x, y);
            }
        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
            root.mid-down = false;
        }
    }
    // A handle's middle events, at their point in the window.
    function middle-at(e: PointerEvent, x: length, y: length) {
        root.middle-event(e, x - ta.absolute-position.x, y - ta.absolute-position.y, false);
    }
    // The area over the picture that had a middle press going away
    // takes its release with it: the pan ends.
    function middle-area-gone() {
        if (!root.mid-view) { root.mid-down = false; }
    }
    changed crop-mode => { root.middle-area-gone(); }
    changed level-mode => { root.middle-area-gone(); }
    changed guide-mode => { root.middle-area-gone(); }
    changed mask-kind => { root.middle-area-gone(); }
    changed handles-down => { root.middle-area-gone(); }
    changed placeholder => { root.middle-area-gone(); }
    // The engine's texture, bound by App's `texture` through this
    // component's id as it was bound to the Image before.
    in property <image> source <=> view.source;

    clip: true;
    background: root.canvas-colors[root.canvas-choice];
    view := Image {
        width: 100%;
        height: 100%;
        image-fit: fill;
    }
    // Putting the tool down, or picking another, drops a part of a
    // step the wheel had added up.
    changed placing => {
        ta.size-acc = 0;
    }
    changed retouch-mode => {
        ta.size-acc = 0;
        root.middle-area-gone();
    }

    ta := TouchArea {
        property <length> last-x;
        property <length> last-y;
        // When the wheel last panned: a whole click's delta soon
        // after is a touchpad's flick, not a wheel's click.
        property <duration> pan-at: -1s;
        // The wheel's delta toward the next step of the brush's or
        // the patch's size, in px.
        property <float> size-acc: 0;
        // Where the press was, and whether it has become a drag.
        property <length> down-x;
        property <length> down-y;
        property <bool> dragged;
        // Whether the press put a dropper down: latched there, so a
        // single-shot dropper (White, Range on the press, the Mixer on
        // the release) that lets go of `picking` inside its own
        // handler still keeps the release from reading as a plain
        // click and zooming.
        property <bool> picked-down;
        // A press that turned the Original back to the edit: its
        // release and its drag do nothing more.
        property <bool> back-down;
        // Whether the press went to a tool placing on the picture,
        // latched for the same reason: the person a part is of is
        // picked on the press, which puts the picking down, and the
        // release must not then read as a click and zoom.
        property <bool> placed-down;
        // Whether the press opened the frame menu: its release is
        // then no click, and a Mac's Control+click no pan.
        property <bool> menu-down;
        // Whether this area had the press the release ends. A press
        // outside a menu closes it and goes to the menu area's parent,
        // not here, while its release does come here: no press, no
        // click.
        property <bool> held;
        // Whether a left drag outside the crop, in crop mode, is
        // drawing a new one: set on the move that first clears the
        // drag threshold, so the release knows to end the gesture
        // there rather than reading as a click.
        property <bool> crop-drawing;
        // Whether a left press landed on the chosen shape's body, and
        // whether its drag has since cleared the threshold and is
        // moving the shape. A press there that never drags is still a
        // click, so it zooms as anywhere else.
        property <bool> body-down;
        property <bool> body-moving;
        // Whether the press landed on the canvas round the picture,
        // where a drag pans nothing. Latched, so a drag that starts on
        // the picture and leaves it still pans.
        property <bool> canvas-down;
        // Whether the press was the hand's (`hand`): the tool stays
        // up, and the drag pans.
        property <bool> hand-down;
        mouse-cursor: root.mid-down ? (root.mid-canvas ? MouseCursor.default : MouseCursor.grabbing)
            : self.hand-down ? MouseCursor.grabbing
            : root.hand && root.hand-tool && !self.pressed ? MouseCursor.grab
            : root.picking != "" ? (root.dropper.width > 0 ? MouseCursor.none : MouseCursor.crosshair)
            : root.placing != "" || root.retouch-mode != "" ? MouseCursor.crosshair
            : root.crop-mode ? MouseCursor.crosshair
            : self.body-moving ? MouseCursor.move
            : !self.pressed && root.mask-body-live && self.has-hover
                && root.mask-body-at(self.mouse-x, self.mouse-y, root.mask-shape-key) ? MouseCursor.move
            : self.pressed ? (self.canvas-down ? MouseCursor.default : MouseCursor.grabbing)
            : self.has-hover && !root.picture-at(self.mouse-x, self.mouse-y) ? MouseCursor.default
            : MouseCursor.grab;
        // The keys belong to the picture whenever the pointer is
        // on it, or the last press was: a clicked slider keeps
        // them while the pointer stays on the panel. Not while a
        // name is being typed somewhere: the pointer crossing the
        // picture must not end the typing; a press on it does.
        changed has-hover => {
            if (self.has-hover && !root.typing) { root.focus-keys(); }
            root.hovered(self.has-hover, self.mouse-x, self.mouse-y);
            // Left without the window's hold: its pan's release went
            // elsewhere.
            if (!self.has-hover && root.mid-view) { root.mid-down = false; }
        }
        // The pointer's place as one value, so a diagonal move, which
        // changes both, is one report and not two.
        property <{x: length, y: length}> pointer-at: { x: self.mouse-x, y: self.mouse-y };
        changed pointer-at => { root.hovered(self.has-hover, self.mouse-x, self.mouse-y); }
        // The press ends: by its own release, a left one a `click`,
        // or by a middle release taking the window's hold on it.
        function end-press(click: bool) {
            if (!ta.held) {
                // The release of a press that closed a menu.
            } else if (ta.menu-down) {
                ta.menu-down = false;
            } else if (ta.back-down) {
                // The press only turned the edit back.
            } else if (ta.hand-down) {
                // The hand's: neither a stroke nor a click's zoom.
            } else if (ta.body-moving) {
                root.mask-dropped();
            } else if (ta.picked-down) {
                root.pick-released();
            } else if (ta.placed-down || root.placing != "" || root.retouch-mode != "") {
                root.place-released();
            } else if (ta.crop-drawing) {
                root.crop-draw-released();
                root.crop-draw-armed = false;
            } else if (root.crop-draw-armed) {
                // Draw in hand and nothing drawn: put down, the
                // crop left as it was and no zoom either.
                root.crop-draw-armed = false;
            } else if (!ta.dragged && click) {
                // A click on the empty picture lets go
                // of a chosen repair, as Esc does.
                if (root.patch != -1) { root.patch-changed(-1); }
                // A click that did not drag: zoom in here, or back out.
                root.toggle-zoom(ta.mouse-x, ta.mouse-y);
            }
            // The gesture is over: the cursor goes back to what
            // is under it.
            ta.held = false;
            ta.body-down = false;
            ta.body-moving = false;
            ta.hand-down = false;
            ta.placed-down = false;
            ta.picked-down = false;
            ta.back-down = false;
            ta.crop-drawing = false;
            root.place-line = false;
        }
        pointer-event(e) => {
            // The middle button's, unless a left gesture is under way
            // (`middle-event`); a press of another button while it pans
            // is nothing, and its release then finds no press.
            if (e.button == PointerEventButton.middle) {
                if (!self.held) {
                    root.middle-event(e, self.mouse-x, self.mouse-y, true);
                } else if (self.placed-down && root.line-tool && e.kind == PointerEventKind.down) {
                    root.place-line = true;
                    root.place-dragged(self.mouse-x, self.mouse-y);
                } else if (e.kind == PointerEventKind.up) {
                    // Its release takes the window's hold on the left
                    // press with it: whatever the press was doing ends
                    // here, a held line where the pointer is.
                    if (root.place-line) { root.place-dragged(self.mouse-x, self.mouse-y); }
                    self.end-press(false);
                }
                return;
            }
            if (e.kind == PointerEventKind.move) {
                // Shift taken or let go in a drag placing a shape holds
                // it or lets it go from this move on; `moved` follows.
                if (self.placed-down) { root.place-shift = e.modifiers.shift; }
                // Only the picture's own pan comes here; another
                // area's coming here means that area is gone.
                if (root.mid-down && root.mid-view) {
                    root.middle-event(e, self.mouse-x, self.mouse-y, true);
                } else if (root.mid-down) {
                    root.mid-down = false;
                }
                return;
            }
            if (e.kind == PointerEventKind.cancel) { root.middle-event(e, self.mouse-x, self.mouse-y, true); }
            if (root.mid-down && (e.kind == PointerEventKind.down || e.kind == PointerEventKind.up)) {
                if (e.kind == PointerEventKind.up) { root.middle-event(e, self.mouse-x, self.mouse-y, true); }
                return;
            }
            if (e.kind == PointerEventKind.down) {
                self.held = true;
                root.focus-keys();
                self.canvas-down = !root.picture-at(self.mouse-x, self.mouse-y);
                // The press that closed the menu: its release is not a
                // click to zoom by, and its drag no pan.
                if (root.menu-shown() && e.button == PointerEventButton.left) {
                    self.menu-down = true;
                    return;
                }
                // The menu, not over a tool: a shape being placed and
                // a repair take the right button for themselves, and
                // a dropper, the level and a guide are half a gesture.
                self.menu-down = (e.button == PointerEventButton.right
                        || (root.ctrl-click-menu && e.button == PointerEventButton.left && e.modifiers.meta))
                    && root.picking == "" && root.placing == "" && root.retouch-mode == ""
                    && !root.level-mode && root.guide-mode == "";
                if (self.menu-down) {
                    root.frame-menu(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                    return;
                }
                // While the camera's JPEG stands in for the
                // develop there is nothing here to place a
                // shape on or read a color off; the pan and
                // the zoom still work, as in culling — a dropper
                // left in hand over the placeholder does not
                // stop a click here from zooming, since nothing
                // was picked to keep it from a plain click.
                self.picked-down = false;
                self.placed-down = false;
                self.back-down = false;
                self.hand-down = (root.hand || (e.modifiers.shift && !root.shift-holds)) && root.hand-tool
                    && e.button == PointerEventButton.left;
                if (root.placeholder) {
                } else if (root.original) {
                    if (root.tool-held) {
                        self.back-down = true;
                        root.original-off();
                    }
                } else if (self.hand-down) {
                } else if (root.wheel-in-hand && e.modifiers.control && e.button == PointerEventButton.left
                        && root.picking == "" && root.placing == "" && root.retouch-mode == ""
                        && !root.level-mode && root.guide-mode == "") {
                    // Held as a dropper's press is, so the release
                    // and a drag after it do nothing more.
                    self.picked-down = true;
                    root.wheel-pick(self.mouse-x, self.mouse-y, e.modifiers.shift);
                } else if (root.picking != "") {
                    self.picked-down = true;
                    if (e.button == PointerEventButton.left) {
                        root.pick-pressed(self.mouse-x, self.mouse-y);
                    }
                } else if (root.placing != "" || root.retouch-mode != "") {
                    self.placed-down = true;
                    root.place-shift = e.modifiers.shift;
                    root.place-pressed(self.mouse-x, self.mouse-y, e.button == PointerEventButton.right);
                }
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                self.down-x = self.mouse-x;
                self.down-y = self.mouse-y;
                self.dragged = false;
                self.crop-drawing = false;
                self.body-moving = false;
                self.body-down = e.button == PointerEventButton.left && !self.picked-down
                    && !self.placed-down && root.mask-body-live
                    && root.mask-body-at(self.mouse-x, self.mouse-y, root.mask-shape-key);
                if (self.body-down) { root.handles-down = false; }
            } else if (e.kind == PointerEventKind.up) {
                self.end-press(e.button == PointerEventButton.left);
            } else if (e.kind == PointerEventKind.cancel) {
                // The window let go of the gesture rather than this
                // press ending it (focus lost, the platform taking
                // over): whatever was mid-flight ends here too, so
                // nothing is left waiting for a release that is not
                // coming.
                if (self.crop-drawing) {
                    root.crop-draw-released();
                    root.crop-draw-armed = false;
                }
                if (self.body-moving) {
                    root.mask-dropped();
                }
                self.held = false;
                self.body-down = false;
                self.body-moving = false;
                self.menu-down = false;
                self.picked-down = false;
                self.back-down = false;
                self.placed-down = false;
                self.dragged = false;
                self.crop-drawing = false;
                self.canvas-down = false;
                self.hand-down = false;
                root.place-line = false;
            }
        }
        moved => {
            // A press not held (one made while the middle pans) is
            // nothing, though the window still marks it pressed; nor
            // is one that turned the Original back.
            if (self.pressed && self.held && !self.menu-down && !self.back-down) {
                if (abs(self.mouse-x - self.down-x) > 4px || abs(self.mouse-y - self.down-y) > 4px) {
                    self.dragged = true;
                }
                if (self.hand-down) {
                    if (self.dragged && !self.canvas-down) {
                        root.pan(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                        root.hand-panned = true;
                    }
                } else if (root.picking != "") {
                    root.pick-dragged(self.mouse-x, self.mouse-y);
                } else if (root.placing != "" || root.retouch-mode != "") {
                    root.place-dragged(self.mouse-x, self.mouse-y);
                } else if (self.dragged && self.body-down) {
                    // On the shape's body: the whole shape moves, by
                    // the same path its center handle takes, from
                    // where the press was.
                    if (!self.body-moving) {
                        self.body-moving = true;
                        root.mask-grabbed(0, false);
                    }
                    root.mask-dragged(0, self.mouse-x - self.down-x, self.mouse-y - self.down-y, false, false);
                } else if (self.dragged && !self.picked-down && !self.placed-down && root.crop-mode && !root.bare) {
                    // Crop mode is a mode: a drag out here draws,
                    // whether or not the picture is zoomed in enough
                    // that a drag would otherwise have panned it. Not
                    // over the camera's JPEG though, the same as the
                    // overlay itself: there is nothing there to draw
                    // against yet, so a drag still just pans.
                    if (!self.crop-drawing) {
                        self.crop-drawing = true;
                        root.crop-draw-pressed(self.down-x, self.down-y);
                    }
                    root.crop-draw-dragged(self.mouse-x, self.mouse-y);
                } else if (self.dragged && !self.picked-down && !self.placed-down && !self.canvas-down) {
                    root.pan(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                }
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
        }
        scroll-event(e) => {
            // Ctrl zooms whatever the delta, by as much of a step as
            // the delta is of a click: a pinch arrives as Ctrl and a
            // stream of small deltas on Windows, and a browser zooms
            // on Ctrl and the wheel too. It comes before the tool's
            // sizing, so a tool in hand zooms the same way.
            if (e.modifiers.control) {
                root.zoom(pow(1.25, e.delta-y / 60px), self.mouse-x, self.mouse-y);
                return accept;
            }
            // With the brush or the retouch patch in hand the wheel
            // sizes it: a step of 1.1x for each 60 px of delta, a
            // wheel click's size, added up as a touchpad's small
            // deltas come, and started over when the direction turns.
            // A size is a value, not content, so under natural
            // scrolling the delta is turned back as a slider's is: the
            // brush grows with a swipe up.
            if (root.placing == "Brush" || root.retouch-mode != "") {
                let dy = SliderKeys.natural ? -e.delta-y : e.delta-y;
                if (self.size-acc * dy < 0) {
                    self.size-acc = 0;
                }
                self.size-acc += dy / 1px;
                if (abs(self.size-acc) >= 60) {
                    let steps = (self.size-acc > 0 ? 1 : -1) * floor(abs(self.size-acc) / 60);
                    self.size-acc -= steps * 60;
                    if (root.placing == "Brush") {
                        root.brush-size = clamp(root.brush-size * pow(1.1, steps), 0.002, 0.5);
                    } else {
                        root.patch-size = clamp(root.patch-size * pow(1.1, steps), 0.002, 0.3);
                        root.patch-edited();
                    }
                }
                return accept;
            }
            // A mouse wheel's click is a single vertical delta of whole
            // clicks (Slint makes a line 60 px) and zooms a step.
            // Anything else, or with a sideways part, is a touchpad's,
            // or a tilted wheel's, and pans. Slint drops the gesture's
            // phase, so a fast flick that happens to land on a whole
            // click is told by its company: within a quarter second
            // of a pan it is part of the pan.
            if (e.delta-x == 0 && e.delta-y != 0
                    && mod(abs(e.delta-y) / 1px, 60) == 0
                    && animation-tick() - self.pan-at > 250ms) {
                root.zoom(e.delta-y > 0 ? 1.25 : 0.8, self.mouse-x, self.mouse-y);
                return accept;
            }
            // Only a sizable pan counts: a flick ramps through deltas
            // of 20 px and more on its way to a click's size, while a
            // high-resolution wheel's fragments are a few pixels, and
            // its whole detent must still zoom.
            if (abs(e.delta-x) + abs(e.delta-y) >= 20px) {
                self.pan-at = animation-tick();
            }
            root.wheel-pan(e.delta-x, e.delta-y);
            return accept;
        }
    }
    // A pinch on a Mac's trackpad zooms about the pointer. A pinch
    // never reaches the scroll handler above; this takes a pinch or a
    // rotation, holds the pointer while one is active, and lets every
    // other event through to the TouchArea under it. Two fingers on a
    // touchscreen reach it too, but Slint first hands the TouchArea a
    // release for the first finger, so such a pinch starts with a
    // click's zoom; untried on hardware.
    ScaleRotateGestureHandler {
        property <float> last-scale: 1;
        started => { self.last-scale = 1; }
        updated => {
            if (self.scale > 0 && self.last-scale > 0) {
                root.zoom(self.scale / self.last-scale, self.center.x, self.center.y);
            }
            self.last-scale = self.scale;
        }
    }
    // The brush under the pointer: its radius, and where
    // its feather begins. The hand at rest keeps it, since
    // Shift and a bracket set the feather it shows; only a
    // drag that pans takes it away.
    if root.placing == "Brush" && ta.has-hover && !root.bare && !ta.hand-down && !root.mid-down: Rectangle {
        for s[k] in [1.0, root.brush-op == "Erase" ? 1.0 : 1.0 - root.brush-feather]: Ring {
            stroke: s == 1.0 ? (root.brush-op == "Erase" ? #ff6060cc : root.brush-op == "Subtract" ? #ffb860cc : #ffffffcc) : #ffffff50;
            halo: k == 0;
            cx: ta.mouse-x / 1px;
            cy: ta.mouse-y / 1px;
            rx: max(root.brush-size * root.brush-scale * s, 0.5);
            ry: self.rx;
        }
    }
    // The word for the camera's JPEG standing in for a
    // develop, in the corner of the picture it is over:
    // the status line says the rest, and both go the
    // moment the develop lands.
    if root.placeholder: Rectangle {
        x: Theme.space-3;
        y: Theme.space-3;
        width: placeholder-word.width + 2 * Theme.space-3;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: root.plate-ground;
        placeholder-word := Text {
            // The word over the stand-in picture while the frame develops
            text: @tr("camera preview");
            color: Theme.over-text;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    // Culling's answer to a key, where the culler is looking: the
    // frame's stars, flag and label in the top right corner of the
    // picture, the strip tile's badge at a size that reads from a
    // chair back, and with the strip put away by Tab. The compared
    // frames carry their own below; one frame alone carries this.
    if root.culling && root.compare-tiles.length == 0: cull-badge := ThumbBadges {
        x: parent.width - self.width - Theme.space-3;
        y: Theme.space-3;
        glyph: 16px;
        light-ground: root.canvas-light;
        rating: root.frame-rating;
        flag: root.frame-flag;
        label: root.frame-label;
        stars: root.meta-stars;
    }
    // The same badge in the develop view, where the strip tile's is
    // otherwise the only answer to a key: up for a moment after one,
    // and for as long as the strip is put away. It takes no pointer,
    // as culling's does not.
    if !root.culling: develop-badge := ThumbBadges {
        x: parent.width - self.width - Theme.space-3;
        y: Theme.space-3;
        glyph: 16px;
        light-ground: root.canvas-light;
        rating: root.frame-rating;
        flag: root.frame-flag;
        label: root.frame-label;
        stars: root.meta-stars;
        // Up at once, the key's answer; only the way down fades.
        opacity: 0;
        states [
            up when root.develop-badge: {
                opacity: 1;
                out {
                    animate opacity { duration: 250ms; easing: ease-out; }
                }
            }
        ]
    }
    // The soft proof, named, in the top left corner: a stray S looks
    // like a broken render without it. The pill is the only part of
    // it that takes the pointer, and a click on it is the way out.
    if root.proof-badge != "": Rectangle {
        x: Theme.space-3;
        y: Theme.space-3;
        width: proof-word.preferred-width + 2 * Theme.space-2;
        height: 20px;
        border-radius: Theme.radius-sm;
        background: root.plate-ground;
        accessible-role: button;
        accessible-label: root.proof-badge;
        proof-word := Text {
            text: root.proof-badge;
            color: Theme.over-text;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        TipArea {
            words: @tr("Soft proof on (S turns it off)");
            clicked => { root.proof-off(); }
        }
    }
    // The compare view's frames: a rule round the one the
    // selection is on, each one's name at its top, and its
    // badge in its own top right corner.
    for t in root.compare-tiles: Rectangle {
        x: t.x * 1px;
        y: t.y * 1px;
        width: t.w * 1px;
        height: t.h * 1px;
        border-width: t.on ? 2px : 0;
        border-color: Theme.accent;
        Rectangle {
            x: Theme.space-2;
            y: Theme.space-2;
            width: tile-name.width + 2 * Theme.space-2;
            height: 20px;
            border-radius: Theme.radius-sm;
            background: root.plate-ground;
            tile-name := Text {
                text: t.name;
                color: t.on ? Theme.over-text : Theme.over-text-secondary;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
        ThumbBadges {
            x: parent.width - self.width - Theme.space-2;
            y: Theme.space-2;
            glyph: 14px;
            light-ground: root.canvas-light;
            rating: t.rating;
            flag: t.flag;
            label: t.label;
            stars: root.meta-stars;
        }
    }
    // The word for the key just pressed, low in the middle of the
    // picture, where the eye is and where it covers the least. It
    // fades on its own timer and is not cleared by anything else,
    // so a culler who rates and arrows on still reads what the key
    // did; the text stays through the fade so the plate does not
    // shrink as it goes.
    if root.culling: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 56px;
        width: notice-word.width + 2 * Theme.space-4;
        height: 40px;
        border-radius: Theme.radius-md;
        background: root.canvas-light ? Theme.over-plate-dense : #000000b0;
        opacity: root.notice-on ? 1 : 0;
        animate opacity { duration: 250ms; easing: ease-out; }
        notice-word := Text {
            text: root.notice;
            color: Theme.over-text;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // The color pick's square about the point, what its mean is
    // taken over: a dark edge outside a light one, to read on any
    // picture.
    if root.picking == "Range" && ta.has-hover && !root.bare: square := Rectangle {
        property <length> side: max(root.range-sample * root.pick-scale * 1px, 3px);
        x: ta.mouse-x - self.side / 2 - 1px;
        y: ta.mouse-y - self.side / 2 - 1px;
        width: self.side + 2px;
        height: self.side + 2px;
        border-width: 1px;
        border-color: #000000aa;
        Rectangle {
            x: 1px;
            y: 1px;
            width: square.side;
            height: square.side;
            border-width: 1px;
            border-color: #ffffffdd;
        }
    }
    // The dropper under the pointer, in place of a cursor:
    // Lucide's pipette has its tip at (2, 22) of a 24 box,
    // so the icon hangs up and to the right of the point. A
    // dark copy behind it, spread by a pixel, reads on light
    // and on dark alike.
    if root.picking != "" && root.dropper.width > 0 && ta.has-hover && !root.bare: Rectangle {
        property <length> size: 22px;
        x: ta.mouse-x - 2 / 24 * self.size;
        y: ta.mouse-y - 22 / 24 * self.size;
        width: self.size;
        height: self.size;
        for o in [
            { dx: -1.0, dy: 0.0 }, { dx: 1.0, dy: 0.0 },
            { dx: 0.0, dy: -1.0 }, { dx: 0.0, dy: 1.0 },
        ]: Image {
            source: root.dropper;
            colorize: #000000cc;
            x: o.dx * 1px;
            y: o.dy * 1px;
            width: parent.width;
            height: parent.height;
        }
        Image {
            source: root.dropper;
            colorize: #ffffff;
            width: 100%;
            height: 100%;
        }
    }
    // The repair tool under the pointer: its radius and feather,
    // kept under the hand at rest as the brush's is.
    if root.retouch-mode != "" && ta.has-hover && !root.bare && !ta.hand-down && !root.mid-down: Rectangle {
        for s[k] in [1.0, 1.0 - root.patch-feather]: Ring {
            stroke: s == 1.0 ? #7fd0ffcc : #7fd0ff50;
            halo: k == 0;
            cx: ta.mouse-x / 1px;
            cy: ta.mouse-y / 1px;
            rx: max(root.patch-size * root.brush-scale * s, 0.5);
            ry: self.rx;
        }
    }
    // The chosen patch's shape while the Retouch tab shows:
    // its edge, and where its feather begins. A heal or a
    // clone shows its result at once and so implies its
    // shape; a fill shows nothing until the model answers,
    // and this is where it was drawn meanwhile and after.
    if root.panel-tab == "Retouch" && root.patch-outline != "" && !root.bare: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.patch-outline;
        stroke: #7fd0ffaa;
        stroke-width: 1px;
    }
    // The Fill patches whose fills are still to come, on any tab: the
    // chosen one's stroke, dimmed, where the picture still shows what
    // they cover.
    if root.pending-outline != "" && !root.bare: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.pending-outline;
        stroke: #7fd0ff55;
        stroke-width: 1px;
    }
    if root.panel-tab == "Retouch" && root.patch-feather-outline != "" && !root.bare: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.patch-feather-outline;
        stroke: #7fd0ff40;
        stroke-width: 1px;
    }
    // The chosen patch's pins: its center and its source,
    // joined by a line.
    if root.retouch-mode != "" && root.patch-handles.length == 2 && !root.bare: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: #7fd0ff99;
        stroke-width: 1px;
        MoveTo { x: root.patch-handles[0].x; y: root.patch-handles[0].y; }
        LineTo { x: root.patch-handles[1].x; y: root.patch-handles[1].y; }
    }
    if root.retouch-mode != "" && !root.bare: Rectangle {
        for h[i] in root.patch-handles: CropHandle {
            id: i;
            x: h.x * 1px - 10px;
            y: h.y * 1px - 10px;
            width: 20px;
            height: 20px;
            cursor: MouseCursor.move;
            Rectangle {
                x: 4px; y: 4px;
                width: 12px; height: 12px;
                background: i == 0 ? #7fd0ff : #ffffff;
                border-radius: 6px;
                border-width: 1px;
                border-color: #00000080;
            }
            grabbed(k) => { root.patch-grabbed(k); }
            dragged(k, dx, dy) => { root.patch-dragged(k, dx, dy); }
            dropped => { root.patch-dropped(); }
            middle(e, x, y) => { root.middle-at(e, x, y); }
        }
    }
    // Alt and a press on the crop, its body or a handle: a fresh crop
    // drawn from there, as a press outside it draws one, rather than
    // the one there moved or resized. Alt is latched on the press,
    // since a handle's own `alt` follows the key on every move, and
    // the press point is kept in the picture area's own coordinates,
    // which is what the draw callbacks take.
    property <bool> crop-alt-down;
    property <bool> crop-alt-drawing;
    property <length> crop-alt-x;
    property <length> crop-alt-y;
    function crop-grabbed(i: int, alt: bool, x: length, y: length) {
        root.crop-alt-down = alt;
        root.crop-alt-drawing = false;
        if (alt) {
            root.crop-alt-x = x - ta.absolute-position.x;
            root.crop-alt-y = y - ta.absolute-position.y;
        } else {
            root.crop-pressed(i);
        }
    }
    function crop-moved(i: int, dx: length, dy: length) {
        if (!root.crop-alt-down) {
            root.crop-dragged(i, dx, dy);
            return;
        }
        // The same few pixels a drag outside the crop must clear.
        if (!root.crop-alt-drawing && (abs(dx) > 4px || abs(dy) > 4px)) {
            root.crop-alt-drawing = true;
            root.crop-draw-pressed(root.crop-alt-x, root.crop-alt-y);
        }
        if (root.crop-alt-drawing) {
            root.crop-draw-dragged(root.crop-alt-x + dx, root.crop-alt-y + dy);
        }
    }
    function crop-dropped() {
        if (!root.crop-alt-down) {
            root.crop-released();
        } else if (root.crop-alt-drawing) {
            root.crop-draw-released();
        }
        root.crop-alt-down = false;
        root.crop-alt-drawing = false;
    }
    // The crop: shade outside, a rule of thirds inside, eight
    // handles and the whole to move.
    if root.crop-mode && !root.bare: Rectangle {
        property <length> cl: root.crop-left;
        property <length> ct: root.crop-top;
        property <length> cw: root.crop-width;
        property <length> ch: root.crop-height;
        Rectangle { x: 0; y: 0; width: 100%; height: ct; background: #00000099; }
        Rectangle { x: 0; y: ct + ch; width: 100%; height: parent.height - ct - ch; background: #00000099; }
        Rectangle { x: 0; y: ct; width: cl; height: ch; background: #00000099; }
        Rectangle { x: cl + cw; y: ct; width: parent.width - cl - cw; height: ch; background: #00000099; }
        CropHandle {
            id: 8;
            x: cl; y: ct; width: cw; height: ch;
            cursor: MouseCursor.move;
            enabled: !root.crop-draw-armed;
            grabbed(i) => {
                root.crop-grabbed(i, self.alt, self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            dragged(i, dx, dy) => { root.crop-moved(i, dx, dy); }
            dropped => { root.crop-dropped(); }
            middle(e, x, y) => { root.middle-at(e, x, y); }
            double-clicked => { root.crop-done(); }
        }
        Rectangle { x: cl; y: ct; width: cw; height: ch; border-width: 1px; border-color: #ffffffcc; }
        Rectangle { x: cl + cw / 3; y: ct; width: 1px; height: ch; background: #ffffff40; }
        Rectangle { x: cl + 2 * cw / 3; y: ct; width: 1px; height: ch; background: #ffffff40; }
        Rectangle { x: cl; y: ct + ch / 3; width: cw; height: 1px; background: #ffffff40; }
        Rectangle { x: cl; y: ct + 2 * ch / 3; width: cw; height: 1px; background: #ffffff40; }
        for h in [
            { id: 0, fx: 0.0, fy: 0.0, cursor: MouseCursor.nwse-resize },
            { id: 1, fx: 0.5, fy: 0.0, cursor: MouseCursor.ns-resize },
            { id: 2, fx: 1.0, fy: 0.0, cursor: MouseCursor.nesw-resize },
            { id: 3, fx: 1.0, fy: 0.5, cursor: MouseCursor.ew-resize },
            { id: 4, fx: 1.0, fy: 1.0, cursor: MouseCursor.nwse-resize },
            { id: 5, fx: 0.5, fy: 1.0, cursor: MouseCursor.ns-resize },
            { id: 6, fx: 0.0, fy: 1.0, cursor: MouseCursor.nesw-resize },
            { id: 7, fx: 0.0, fy: 0.5, cursor: MouseCursor.ew-resize },
        ]: CropHandle {
            id: h.id;
            x: cl + h.fx * cw - 10px;
            y: ct + h.fy * ch - 10px;
            width: 20px;
            height: 20px;
            cursor: h.cursor;
            enabled: !root.crop-draw-armed;
            Rectangle {
                x: 5px; y: 5px; width: 10px; height: 10px;
                background: #ffffff;
                border-radius: 2px;
                border-width: 1px;
                border-color: #00000080;
            }
            grabbed(i) => {
                root.crop-grabbed(i, self.alt, self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            dragged(i, dx, dy) => { root.crop-moved(i, dx, dy); }
            dropped => { root.crop-dropped(); }
            middle(e, x, y) => { root.middle-at(e, x, y); }
        }
    }
    // The grid while the angle is set: over the crop in crop mode,
    // where the thirds already are, over the whole view otherwise.
    if root.angle-dragging && !root.bare: AlignGrid {
        x: root.crop-mode ? root.crop-left : 0;
        y: root.crop-mode ? root.crop-top : 0;
        width: root.crop-mode ? root.crop-width : parent.width;
        height: root.crop-mode ? root.crop-height : parent.height;
    }
    // The chosen mask shape: its outline and its handles.
    if root.mask-kind == "Linear" && root.mask-handles.length == 3 && !root.bare && !root.handles-down: Rectangle {
        for h[i] in root.mask-handles: Rule {
            stroke: i == 0 ? #ffffff60 : #ffffffcc;
            halo: i != 0;
            property <float> dx: cos(root.mask-angle * 1deg) * 4000;
            property <float> dy: sin(root.mask-angle * 1deg) * 4000;
            x0: h.x - self.dx;
            y0: h.y - self.dy;
            x1: h.x + self.dx;
            y1: h.y + self.dy;
        }
    }
    if root.mask-kind == "Radial" && root.mask-handles.length == 5 && !root.bare && !root.handles-down: Rectangle {
        for s[k] in [1.0, root.mask-feather-scale]: Ring {
            stroke: s == 1.0 ? #ffffffcc : #ffffff50;
            halo: k == 0;
            cx: root.mask-handles[0].x;
            cy: root.mask-handles[0].y;
            rx: max(root.mask-rx * s, 0.5);
            ry: max(root.mask-ry * s, 0.5);
            angle: root.mask-angle;
        }
    }
    // An object's boxes, and its picks: a dot, green for
    // the object and red for what is not it.
    if !root.bare: Rectangle {
        for b in root.mask-boxes: Rectangle {
            x: b.x * 1px;
            y: b.y * 1px;
            width: b.w * 1px;
            height: b.h * 1px;
            border-width: 1px;
            border-color: #ffffffcc;
            Rectangle {
                x: 1px; y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-width: 1px;
                border-color: #00000066;
            }
        }
        for k in root.mask-picks: Rectangle {
            x: k.x * 1px - 6px;
            y: k.y * 1px - 6px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: k.positive ? #4cd964 : #ff5252;
            border-width: 1px;
            border-color: #000000a0;
        }
    }
    // The people a part may be of, while one is to be picked: each
    // face outlined, the guess in the accent and heavier.
    if !root.bare: Rectangle {
        for b in root.person-boxes: Rectangle {
            x: b.x * 1px - 4px;
            y: b.y * 1px - 4px;
            width: b.w * 1px + 8px;
            height: b.h * 1px + 8px;
            border-radius: 6px;
            border-width: b.guess ? 3px : 1.5px;
            border-color: b.guess ? Theme.accent : #ffffffd0;
            Rectangle {
                x: parent.border-width;
                y: parent.border-width;
                width: parent.width - 2 * parent.border-width;
                height: parent.height - 2 * parent.border-width;
                border-radius: 5px;
                border-width: 1px;
                border-color: #00000080;
            }
        }
    }
    // While a person is to be picked: everyone's instead, over the
    // picture where the clicks go, never below the panel's fold.
    if root.placing == "Part" && !root.bare: PanelButton {
        x: (parent.width - self.width) / 2;
        y: 12px;
        width: 140px;
        // People mask: the button over the picture that takes everyone in it
        text: @tr("All people");
        icon: @image-url("../icons/users-round.svg");
        primary: true;
        clicked => { root.all-people(); }
    }
    if root.mask-kind != "" && !root.bare && !root.handles-down: Rectangle {
        for h[i] in root.mask-handles: CropHandle {
            id: i;
            x: h.x * 1px - 10px;
            y: h.y * 1px - 10px;
            width: 20px;
            height: 20px;
            cursor: i == 0 ? MouseCursor.move : MouseCursor.crosshair;
            Rectangle {
                x: i == 0 ? 4px : 5px; y: i == 0 ? 4px : 5px;
                width: i == 0 ? 12px : 10px; height: i == 0 ? 12px : 10px;
                background: i == 0 ? Theme.accent : #ffffff;
                border-radius: i == 0 ? 6px : 2px;
                border-width: 1px;
                border-color: #00000080;
            }
            grabbed(k) => { root.mask-grabbed(k, self.press-modifiers.shift); }
            dragged(k, dx, dy) => { root.mask-dragged(k, dx, dy, self.alt, self.shift); }
            dropped => { root.mask-dropped(); }
            middle(e, x, y) => { root.middle-at(e, x, y); }
        }
    }
    // The level tool: drag along a line that should be
    // horizontal or vertical.
    if root.level-mode && !root.bare: leveler := Rectangle {
        property <length> x0;
        property <length> y0;
        property <length> x1;
        property <length> y1;
        property <bool> dragging: false;
        level := TouchArea {
            mouse-cursor: root.mid-down ? MouseCursor.grabbing : MouseCursor.crosshair;
            pointer-event(e) => {
                // The middle button's pan, as on the picture.
                if ((e.button == PointerEventButton.middle && !self.pressed) || root.mid-down) {
                    root.middle-at(e, self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                    return;
                }
                // Cancel carries button `other`: read ahead of the
                // filter, it drops the stroke, so a later lone release
                // finds none to end.
                if (e.kind == PointerEventKind.cancel) {
                    leveler.dragging = false;
                    return;
                }
                // A middle release in the stroke takes the window's hold
                // on it: the stroke ends there, as at its own release.
                if (e.button != PointerEventButton.left
                        && !(e.button == PointerEventButton.middle && e.kind == PointerEventKind.up)) {
                    return;
                }
                if (e.kind == PointerEventKind.down) {
                    leveler.x0 = self.mouse-x; leveler.y0 = self.mouse-y;
                    leveler.x1 = self.mouse-x; leveler.y1 = self.mouse-y;
                    leveler.dragging = true;
                } else if (e.kind == PointerEventKind.up && leveler.dragging) {
                    leveler.dragging = false;
                    root.level-end(leveler.x0, leveler.y0, self.mouse-x, self.mouse-y);
                }
            }
            moved => {
                if (self.pressed) { leveler.x1 = self.mouse-x; leveler.y1 = self.mouse-y; }
            }
        }
        if leveler.dragging: AlignGrid { width: 100%; height: 100%; }
        if leveler.dragging: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            stroke: Theme.accent;
            stroke-width: 2px;
            MoveTo { x: leveler.x0 / 1px; y: leveler.y0 / 1px; }
            LineTo { x: leveler.x1 / 1px; y: leveler.y1 / 1px; }
        }
    }
    // The perspective guide: two strokes along lines that
    // should stand up, or lie flat. The first is kept in
    // source pixels by Rust and drawn back through the view
    // each frame, so a zoom or a pan between the strokes
    // moves the line with the picture rather than under it;
    // the pair gives the turn and the keystone at once, and
    // the tool lets go.
    if root.guide-mode != "" && !root.bare: guider := Rectangle {
        // The stroke in hand.
        property <length> x0;
        property <length> y0;
        property <length> x1;
        property <length> y1;
        property <bool> dragging: false;
        guide := TouchArea {
            mouse-cursor: root.mid-down ? MouseCursor.grabbing : MouseCursor.crosshair;
            changed has-hover => {
                if (self.has-hover && !root.typing) { root.focus-keys(); }
            }
            pointer-event(e) => {
                // The middle button's pan, as on the picture.
                if ((e.button == PointerEventButton.middle && !self.pressed) || root.mid-down) {
                    root.middle-at(e, self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                    return;
                }
                // Cancel carries button `other`: read ahead of the
                // filter, it drops the stroke, so a later lone release
                // finds none to end.
                if (e.kind == PointerEventKind.cancel) {
                    guider.dragging = false;
                    return;
                }
                // A middle release in the stroke ends it, as the level's.
                if (e.button != PointerEventButton.left
                        && !(e.button == PointerEventButton.middle && e.kind == PointerEventKind.up)) {
                    return;
                }
                if (e.kind == PointerEventKind.down) {
                    root.focus-keys();
                    guider.x0 = self.mouse-x; guider.y0 = self.mouse-y;
                    guider.x1 = self.mouse-x; guider.y1 = self.mouse-y;
                    guider.dragging = true;
                } else if (e.kind == PointerEventKind.up && guider.dragging) {
                    guider.dragging = false;
                    // A stroke too short to say which way a
                    // line runs is no stroke at all.
                    if (abs(self.mouse-x - guider.x0) + abs(self.mouse-y - guider.y0) < 12px) { return; }
                    // Which of the two this is, Rust says:
                    // it holds the first one.
                    root.guide-stroke(guider.x0, guider.y0, self.mouse-x, self.mouse-y);
                }
            }
            moved => {
                if (self.pressed) { guider.x1 = self.mouse-x; guider.y1 = self.mouse-y; }
            }
        }
        if root.guide-kept.length == 2: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            stroke: Theme.accent;
            stroke-width: 2px;
            MoveTo { x: root.guide-kept[0].x; y: root.guide-kept[0].y; }
            LineTo { x: root.guide-kept[1].x; y: root.guide-kept[1].y; }
        }
        if guider.dragging: Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            stroke: Theme.accent;
            stroke-width: 2px;
            MoveTo { x: guider.x0 / 1px; y: guider.y0 / 1px; }
            LineTo { x: guider.x1 / 1px; y: guider.y1 / 1px; }
        }
        // What to do, while the tool is in hand.
        Rectangle {
            y: Theme.space-3;
            width: hint.width + 2 * Theme.space-3;
            height: 24px;
            border-radius: Theme.radius-md;
            background: root.plate-ground;
            hint := Text {
                text: root.guide-kept.length == 2
                    ? @tr("Now the second line")
                    : root.guide-mode == "Vertical"
                        ? @tr("Drag along two lines that should stand upright")
                        : @tr("Drag along two lines that should lie flat");
                color: #ffffff;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
    }
    // Status, bottom left, on a soft plate; a bar runs while
    // a develop is on its way. Nothing to say, no plate.
    plate := Rectangle {
        visible: !root.plate-hidden
            && (status-text.text != "" || root.busy || root.filling || root.sync-note != "");
        x: Theme.space-3;
        y: parent.height - self.height - Theme.space-3;
        width: status-text.width + 2 * Theme.space-3 + (root.busy || root.filling ? 72px : 0)
            + (root.sync-note != "" ? sync-text.width + Theme.space-3 : 0);
        height: 24px;
        border-radius: Theme.radius-md;
        background: root.plate-ground;
        property <float> phase: 0;
        Timer {
            interval: 16ms;
            running: root.busy;
            triggered => { plate.phase = mod(plate.phase + 0.015, 1); }
        }
        if root.busy: Rectangle {
            x: Theme.space-3;
            y: (parent.height - self.height) / 2;
            width: 60px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.over-track;
            clip: true;
            Rectangle {
                x: (parent.width + 24px) * plate.phase - 24px;
                width: 24px;
                height: 100%;
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }
        // The fill's bar, the camera match's: filled to the steps made.
        if root.filling: Rectangle {
            x: Theme.space-3;
            y: (parent.height - self.height) / 2;
            width: 60px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.over-track;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.fill-fraction, 0, 1);
                height: 100%;
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }
        status-text := Text {
            text: root.placeholder && root.placeholder-status != "" ? root.placeholder-status : root.status;
            color: Theme.over-text-secondary;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            x: Theme.space-3 + (root.busy || root.filling ? 72px : 0);
            height: 100%;
        }
        sync-text := Text {
            visible: root.sync-note != "";
            text: root.sync-note;
            color: Theme.over-text-secondary;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            x: status-text.x + status-text.width + Theme.space-3;
            height: 100%;
            TouchArea {
                clicked => { root.sync-retry(); }
            }
        }
    }
}
