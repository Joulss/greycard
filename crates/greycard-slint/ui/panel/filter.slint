// The browser's filter bar and its chips: the grid's header holds one
// and the CULLING section another.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FilterChip, FacetRow, SortMenu } from "../structs.slint";
import { PanelButton, Typing } from "../controls.slint";

// A chip of the filter: a pill that says what it asks and how many
// frames it would leave. A chip that leads nowhere is dimmed rather
// than dropped, so the row does not move about under the pointer as
// a cull goes on. A chip held out (Ctrl+click, Cmd on a Mac) is drawn
// in red.
component Chip inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> on;
    in property <bool> out: false;
    in property <bool> has-dot: false;
    in property <bool> outlined: false;
    /// A chip that is a toggle rather than a question about the
    /// folder has nothing to count.
    in property <bool> shows-count: true;
    /// The panel is 280 to a third of the window wide and the header
    /// is wider, so a chip on the panel is spelled closer.
    in property <bool> tight: false;
    in property <color> dot: Theme.text-muted;
    /// Whether Ctrl (Cmd on a Mac) was held: the press holds the
    /// chip out rather than ticking it.
    callback clicked(bool);
    property <bool> nowhere: root.shows-count && root.count == 0 && !root.on && !root.out;
    height: Theme.control-height - 4px;
    border-radius: (Theme.control-height - 4px) / 2;
    border-width: 1px;
    border-color: root.out ? Theme.warn-red : root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.selection : (ta.has-hover ? Theme.hover : Theme.base);
    opacity: root.nowhere ? 0.45 : 1;
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: root.tight ? Theme.space-1 : Theme.space-2;
        padding-right: root.tight ? Theme.space-1 : Theme.space-2;
        spacing: root.tight ? 3px : Theme.space-1;
        alignment: center;
        if root.has-dot: Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.dot;
            border-width: root.outlined ? 1px : 0;
            border-color: Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.out ? Theme.warn-red : root.on ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: root.on || root.out ? Theme.weight-medium : Theme.weight-regular;
            vertical-alignment: center;
        }
        if root.shows-count: Text {
            text: root.count;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        property <bool> ctrl;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.ctrl = e.modifiers.control;
            }
        }
        clicked => { root.clicked(self.ctrl); }
    }
}

// A label chip, which says its color rather than its name.
component LabelChip inherits Chip {
    in property <int> label-code;
    has-dot: true;
    outlined: root.label-code == 0;
    dot: root.label-code == 1 ? Theme.label-red
        : root.label-code == 2 ? Theme.label-yellow
        : root.label-code == 3 ? Theme.label-green
        : root.label-code == 4 ? Theme.label-blue
        : root.label-code == 5 ? Theme.label-purple
        : transparent;
}

// A facet's row: its caption, then its chips, scrolled sideways when
// they run past the bar rather than wrapped. The caption goes first
// and stays with them, so a row of numbers says what it counts. The
// wheel scrolls it: Slint's Flickable moves sideways only for a drag
// or Shift and the wheel, which most people would never find, so an
// up-and-down turn over the row is taken as a sideways one, up to the
// row's end, where it goes on to scroll the panel.
component FacetChips inherits Rectangle {
    in property <[FacetRow]> facets;
    in property <string> note;
    in property <bool> tight: false;
    callback toggled(int, string, bool);
    height: Theme.control-height - 4px;
    clip: true;
    flick := Flickable {
        content-width: max(self.width, row.preferred-width);
        content-height: self.height;
        TouchArea {
            width: max(flick.width, row.preferred-width);
            height: flick.height;
            scroll-event(e) => {
                if (row.preferred-width <= flick.width) { return reject; }
                let to = max(flick.width - row.preferred-width,
                    min(0px, flick.content-x + (e.delta-x != 0px ? e.delta-x : e.delta-y)));
                // At its end the wheel goes on to the panel.
                if (to == flick.content-x) { return reject; }
                flick.content-x = to;
                return accept;
            }
        row := HorizontalLayout {
            spacing: Theme.space-1;
            alignment: start;
            if root.note != "": Text {
                text: root.note;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            for facet in root.facets: HorizontalLayout {
                spacing: root.tight ? 3px : Theme.space-1;
                Text {
                    text: facet.name;
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                for chip in facet.chips: Chip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    out: chip.out;
                    tight: root.tight;
                    clicked(ctrl) => { root.toggled(facet.code, chip.key, ctrl); }
                }
                Rectangle { width: Theme.space-2; }
            }
        }
        }
    }
}

// The Sort button and its menu: at the end of the filter bar, and on
// the grid's top row while the bar is put away. The button says what
// the list is by and which way up, and opens the menu.
export component SortButton inherits PanelButton {
    in property <SortMenu> sort;
    /// Raised from Rust, for a snapshot of the menu open: the button
    /// on screen opens it and puts this back.
    in-out property <bool> sort-shown;
    in property <bool> takes-focus: true;
    callback picked(int);
    callback turned(bool);
    callback released();
    property <bool> want: root.sort-shown && root.takes-focus;
    changed want => {
        if (self.want) {
            root.sort-shown = false;
            sort-menu.show({ x: 0, y: self.height });
        }
    }
    // A picture and no words, so the header's row keeps its chips at
    // the editor's default width: the arrows say which way up, the tip
    // at the pointer what by, and the menu checks both.
    words: root.sort.tip;
    icon: root.sort.ways.length == 0 ? @image-url("../icons/arrow-up-down.svg")
        : root.sort.descending ? @image-url("../icons/arrow-down-wide-narrow.svg")
        : @image-url("../icons/arrow-up-narrow-wide.svg");
    width: Theme.control-height;
    accessible-role: button;
    accessible-label: root.sort.tip;
    clicked => {
        root.released();
        sort-menu.show({ x: 0, y: self.height });
    }
    sort-menu := ContextMenuArea {
        width: 0px;
        height: 0px;
        enabled: false;
        Menu {
            for name[i] in root.sort.entries: MenuItem {
                title: name;
                checkable: true;
                checked: i == root.sort.checked;
                activated => { root.picked(i); }
            }
            if root.sort.ways.length > 0: MenuSeparator { }
            for way[i] in root.sort.ways: MenuItem {
                title: way;
                checkable: true;
                checked: (i == 1) == root.sort.descending;
                activated => { root.turned(i == 1); }
            }
        }
    }
}

// The browser's filter: the rating chips and how they read, the flag
// chips, the label chips, the facets (the EXIF's, the keyword and
// the file's kind), and words or terms looked for. In the grid's
// header, one row of chips with the words at its end and a row of
// facets under it; the same chips a group to a row in the CULLING
// section, where the panel, 280px at its narrowest, could not hold
// the header's row.
export component FilterBar inherits Rectangle {
    in property <[FilterChip]> stars;
    in property <[FilterChip]> flags;
    in property <[FilterChip]> labels;
    /// The facets with a value in the folder: camera, lens, kind,
    /// style, ISO, focal length, day and keyword. The EXIF's are the
    /// library index's, empty until it has rows for the folder, when
    /// `facet-note` says why; the kind is the paths' and the keyword
    /// the sidecars'.
    in property <[FacetRow]> facets;
    /// The header's two rows of them, split by the window: camera and
    /// lens, whose chips run long, then the rest. The stacked bar takes
    /// `facets` as one column.
    in property <[FacetRow]> facets-long;
    in property <[FacetRow]> facets-short;
    in property <string> facet-note;
    in property <bool> exact;
    in property <int> shown;
    in property <int> total;
    in property <bool> on;
    in property <bool> stacked: false;
    /// A key has asked for the text field. The bar on screen takes
    /// the focus and puts this back to false, so that one press is
    /// answered once: the grid's header is built when the grid
    /// opens, which is a moment after the key, and a bar built later
    /// for some other reason must not take the keys off whatever
    /// has them.
    in-out property <bool> wanted;
    /// Whether this bar is the one on screen: the grid's header and
    /// the CULLING section both hold one, and only one of them may
    /// answer the key.
    in property <bool> takes-focus: true;
    in-out property <string> text;
    callback star-picked(int);
    /// A flag or label chip, and whether Ctrl held it out.
    callback flag-toggled(int, bool);
    callback label-toggled(int, bool);
    callback exact-toggled();
    /// A facet's chip, by the facet's code and the chip's value.
    callback facet-toggled(int, string, bool);
    callback text-edited(string);
    callback cleared();
    /// Whether the bar offers to keep its filter as a smart
    /// collection: the grid's does, the CULLING section's does not.
    in property <bool> can-save: false;
    callback save-smart();
    /// The field is done with: the window's keys want it back.
    callback released();
    /// The Sort menu, at the bar's end: the view's order and its way
    /// up, one choice a view.
    in property <SortMenu> sort;
    /// An entry of the menu picked, by its place in `sort.entries`.
    callback sort-picked(int);
    /// A way up picked: descending or not.
    callback sort-turned(bool);
    /// Raised from Rust, for a snapshot of the menu open: the bar on
    /// screen opens it and puts this back.
    in-out property <bool> sort-shown;
    function grab() {
        root.wanted = false;
        field.focus();
        // A query already in the field is selected, so the next
        // character replaces it: the key is usually pressed to look
        // for something else.
        field.select-all();
    }
    // Answered here when the bar was already up, and on `init` when
    // it was built by the same press.
    changed wanted => { if (root.wanted && root.takes-focus) { root.grab(); } }
    init => { if (root.wanted && root.takes-focus) { root.grab(); } }
    VerticalLayout {
        spacing: Theme.space-2;
        // The panel's chip groups: Stars keeps its mode on the caption
        // row; each chip row scrolls sideways when it runs past the panel.
        if root.stacked: VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    // Filter bar: the rating row
                    text: @tr("Stars");
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Chip {
                    // Filter bar: the rating's two modes
                    text: root.exact ? @tr("exactly") : @tr("or more");
                    shows-count: false;
                    tight: true;
                    on: root.exact;
                    clicked(ctrl) => { root.exact-toggled(); }
                }
            }
            Rectangle {
                height: Theme.control-height - 4px;
                clip: true;
                stars-flick := Flickable {
                    content-width: max(self.width, stars-row.preferred-width);
                    content-height: self.height;
                    TouchArea {
                        width: max(stars-flick.width, stars-row.preferred-width);
                        height: stars-flick.height;
                        scroll-event(e) => {
                            if (stars-row.preferred-width <= stars-flick.width) { return reject; }
                            let to = max(stars-flick.width - stars-row.preferred-width,
                                min(0px, stars-flick.content-x + (e.delta-x != 0px ? e.delta-x : e.delta-y)));
                            // At its end the wheel goes on to the panel.
                            if (to == stars-flick.content-x) { return reject; }
                            stars-flick.content-x = to;
                            return accept;
                        }
                    }
                    stars-row := HorizontalLayout {
                        spacing: 3px;
                        alignment: start;
                        for chip[i] in root.stars: Chip {
                            text: chip.text;
                            count: chip.count;
                            on: chip.on;
                            tight: true;
                            clicked(ctrl) => { root.star-picked(i); }
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.control-height - 4px;
                clip: true;
                flag-flick := Flickable {
                    content-width: max(self.width, flag-row.preferred-width);
                    content-height: self.height;
                    TouchArea {
                        width: max(flag-flick.width, flag-row.preferred-width);
                        height: flag-flick.height;
                        scroll-event(e) => {
                            if (flag-row.preferred-width <= flag-flick.width) { return reject; }
                            let to = max(flag-flick.width - flag-row.preferred-width,
                                min(0px, flag-flick.content-x + (e.delta-x != 0px ? e.delta-x : e.delta-y)));
                            // At its end the wheel goes on to the panel.
                            if (to == flag-flick.content-x) { return reject; }
                            flag-flick.content-x = to;
                            return accept;
                        }
                    }
                    flag-row := HorizontalLayout {
                        spacing: Theme.space-1;
                        alignment: start;
                        Text {
                            // Filter bar: the flag row
                            text: @tr("Flag");
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            for chip[i] in root.flags: Chip {
                                text: chip.text;
                                count: chip.count;
                                on: chip.on;
                                out: chip.out;
                                tight: true;
                                clicked(ctrl) => { root.flag-toggled(i, ctrl); }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.control-height - 4px;
                clip: true;
                label-flick := Flickable {
                    content-width: max(self.width, label-row.preferred-width);
                    content-height: self.height;
                    TouchArea {
                        width: max(label-flick.width, label-row.preferred-width);
                        height: label-flick.height;
                        scroll-event(e) => {
                            if (label-row.preferred-width <= label-flick.width) { return reject; }
                            let to = max(label-flick.width - label-row.preferred-width,
                                min(0px, label-flick.content-x + (e.delta-x != 0px ? e.delta-x : e.delta-y)));
                            // At its end the wheel goes on to the panel.
                            if (to == label-flick.content-x) { return reject; }
                            label-flick.content-x = to;
                            return accept;
                        }
                    }
                    label-row := HorizontalLayout {
                        spacing: Theme.space-1;
                        alignment: start;
                        Text {
                            // Filter bar: the label row
                            text: @tr("Label");
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 1px;
                            alignment: start;
                            for chip[i] in root.labels: LabelChip {
                                text: chip.text;
                                count: chip.count;
                                on: chip.on;
                                out: chip.out;
                                tight: true;
                                label-code: chip.code;
                                clicked(ctrl) => { root.label-toggled(i, ctrl); }
                            }
                        }
                    }
                }
            }
            // A facet to a row here, each scrolled on its own: a
            // lens's name alone can be most of the panel's width.
            if root.facet-note != "": Text {
                text: root.facet-note;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            for facet in root.facets: FacetChips {
                facets: [facet];
                tight: true;
                toggled(code, key, ctrl) => { root.facet-toggled(code, key, ctrl); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            // The header's chips, every group along the row before
            // the words, with a rule between the groups. They keep
            // their width while the field has some to give, and past
            // that are clipped rather than wrapped at a narrow window.
            if !root.stacked: Rectangle {
                clip: true;
                min-width: 0px;
                preferred-width: chips.preferred-width;
                horizontal-stretch: 0;
                chips := HorizontalLayout {
                    x: 0;
                    width: max(parent.width, self.preferred-width);
                    height: Theme.control-height - 4px;
                    y: (parent.height - self.height) / 2;
                    spacing: Theme.space-1;
                    alignment: start;
                    for chip[i] in root.stars: Chip {
                        text: chip.text;
                        count: chip.count;
                        on: chip.on;
                        clicked(ctrl) => { root.star-picked(i); }
                    }
                    Chip {
                        text: root.exact ? @tr("exactly") : @tr("or more");
                        shows-count: false;
                        on: root.exact;
                        clicked(ctrl) => { root.exact-toggled(); }
                    }
                    Rectangle { width: Theme.space-2; }
                    Rectangle { width: 1px; background: Theme.border; }
                    Rectangle { width: Theme.space-2; }
                    for chip[i] in root.flags: Chip {
                        text: chip.text;
                        count: chip.count;
                        on: chip.on;
                        out: chip.out;
                        clicked(ctrl) => { root.flag-toggled(i, ctrl); }
                    }
                    Rectangle { width: Theme.space-2; }
                    Rectangle { width: 1px; background: Theme.border; }
                    Rectangle { width: Theme.space-2; }
                    for chip[i] in root.labels: LabelChip {
                        text: chip.text;
                        count: chip.count;
                        on: chip.on;
                        out: chip.out;
                        label-code: chip.code;
                        clicked(ctrl) => { root.label-toggled(i, ctrl); }
                    }
                }
            }
            // What is left over, between the chips and the words, so
            // the words, the count and Clear keep to the right.
            if !root.stacked: Rectangle { horizontal-stretch: 1; }
            field := LineEdit {
                text <=> root.text;
                // Filter bar's search hint; camera: and iso>= stay English
                placeholder-text: @tr("Name, keyword, or camera:R6 iso>=3200");
                // Wide enough for a few words and no wider: a field
                // the width of the window reads as the header rather
                // than as one control in it. In the header it gives
                // up width to the chips down to what a few words need:
                // at the editor's default width, the chips, the count,
                // Save..., Clear and the Sort button all fit with it.
                max-width: root.stacked ? 100000px : 360px;
                min-width: root.stacked ? 0px : 136px;
                // Match Clear and Sort in both the panel and the header.
                height: Theme.control-height;
                horizontal-stretch: 1;
                edited(t) => { root.text-edited(t); }
                accepted(t) => { root.released(); }
                changed has-focus => { Typing.box-focus(self.has-focus); }
                key-pressed(e) => {
                    // Esc undoes the whole excursion in one press:
                    // the words go and the window's keys have the
                    // focus back, so the next 1 to 5 is a rating
                    // again and not a character.
                    if (e.text == Key.Escape) {
                        self.text = "";
                        root.text-edited("");
                        root.released();
                        return accept;
                    }
                    return reject;
                }
            }
            // The count, and in the CULLING section's bar the order in
            // words (the arrows on the Sort button say which way up).
            // The grid's header says the order on its top row instead,
            // where it takes no room from the chips.
            Text {
                // Filter bar: frames shown of the frames in the folder
                text: @tr("{} of {}", root.shown, root.total)
                    + (root.stacked && root.sort.label != "" ? " · " + root.sort.label : "");
                color: root.on ? Theme.text : Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            // The buttons keep their words: the chips before them give
            // way first, clipped at a narrow window.
            if root.can-save: PanelButton {
                // Filter bar: save the filter as a smart collection
                text: @tr("Save...");
                min-width: self.preferred-width;
                enabled: root.on;
                clicked => { root.released(); root.save-smart(); }
            }
            PanelButton {
                text: @tr("Clear");
                min-width: self.preferred-width;
                enabled: root.on;
                clicked => { root.cleared(); root.released(); }
            }
            // The order, last on the row: the button says what the
            // list is by and which way up, and opens the menu.
            SortButton {
                sort: root.sort;
                sort-shown <=> root.sort-shown;
                takes-focus: root.takes-focus;
                picked(i) => { root.sort-picked(i); }
                turned(d) => { root.sort-turned(d); }
                released => { root.released(); }
            }
        }
        // The first row also carries the note, before its chips: the
        // index's progress, or why it has nothing. The second is there
        // only when it has something.
        if !root.stacked && (root.facets-long.length > 0 || root.facets-short.length == 0
            || root.facet-note != ""): FacetChips {
            facets: root.facets-long;
            note: root.facet-note;
            toggled(code, key, ctrl) => { root.facet-toggled(code, key, ctrl); }
        }
        if !root.stacked && root.facets-short.length > 0: FacetChips {
            facets: root.facets-short;
            toggled(code, key, ctrl) => { root.facet-toggled(code, key, ctrl); }
        }
    }
}
